<ui:FluentWindow x:Class="Reframe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:Reframe"
        xmlns:vm="clr-namespace:Reframe.ViewModels"
        xmlns:core="clr-namespace:Reframe.Core.Transformers;assembly=Reframe.Core"
        xmlns:conv="clr-namespace:Reframe.Converters"
        xmlns:controls="clr-namespace:Reframe.Controls"
        xmlns:line="clr-namespace:Reframe.Core.Transformers.Line;assembly=Reframe.Core"
        mc:Ignorable="d"
        Title="Reframe - General Purpose Text Analyzer &amp; Transformer"
        Height="820" Width="1300"
        MinHeight="620" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="None"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        ExtendsContentIntoTitleBar="True"
        AllowDrop="True"
        Drop="MainWindow_Drop"
        DragOver="MainWindow_DragOver">

    <ui:FluentWindow.DataContext>
        <vm:MainViewModel/>
    </ui:FluentWindow.DataContext>

    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="K" Modifiers="Control" Command="{Binding OpenCommandPaletteCommand}"/>
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding OpenCommandPaletteCommand}"/>
        <KeyBinding Key="P" Modifiers="Control+Shift" Command="{Binding OpenCommandPaletteCommand}"/>
        <KeyBinding Key="F1" Command="{Binding OpenCommandPaletteCommand}"/>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding LoadFileCommand}"/>
        <KeyBinding Key="I" Modifiers="Control+Shift" Command="{Binding SendToInputCommand}"/>
        <KeyBinding Key="I" Modifiers="Alt" Command="{Binding SendToInputCommand}"/>
        <KeyBinding Key="F4" Command="{Binding SendToInputCommand}"/>
        <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding HistoryBackCommand}"/>
        <KeyBinding Key="Right" Modifiers="Alt" Command="{Binding HistoryForwardCommand}"/>
        <KeyBinding Key="F5" Command="{Binding ExecuteCurrentPipelineCommand}"/>
    </ui:FluentWindow.InputBindings>

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <conv:BooleanToTextWrappingConverter x:Key="BoolToWrapConv"/>
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>

        <!-- Secondary Tool Button Style -->
        <Style x:Key="SecondaryToolButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource ControlStrongFillColorDefaultBrush}" />
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="{DynamicResource SystemAccentColorBrush}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" />
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.4" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <!-- TitleBar -->
            <RowDefinition Height="Auto"/>
            <!-- Top Command Bar / Header -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
            <!-- Bottom Status Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Modern Fluent TitleBar -->
        <ui:TitleBar Grid.Row="0"
                     Title="Reframe"
                     ShowMaximize="True"
                     ShowMinimize="True"
                     ShowClose="True"
                     Height="30"
                     Padding="8,4"/>

        <!-- Top Header & Toolbar -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceDarkBackgroundBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand / Logo & Detected Format -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
                    <ui:SymbolIcon Symbol="Code20" FontSize="18" Foreground="{DynamicResource AccentBlueBadgeBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <Border Background="#20007ACC" BorderBrush="#40007ACC" BorderThickness="1" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Format: " Foreground="{DynamicResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DetectedFormatBadge}" Foreground="{DynamicResource AccentSuccessBrush}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Quick Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <ui:Button Appearance="Secondary" Command="{Binding HistoryBackCommand}" ToolTip="Restore previous input snapshot (Alt+Left)" Margin="0,0,4,0" Padding="8,4" Icon="{ui:SymbolIcon Symbol=ArrowUndo24}">
                        <TextBlock Text="Back" FontSize="11"/>
                    </ui:Button>
                    <ui:Button Appearance="Secondary" Command="{Binding HistoryForwardCommand}" ToolTip="Restore next input snapshot (Alt+Right)" Margin="0,0,8,0" Padding="8,4" Icon="{ui:SymbolIcon Symbol=ArrowRedo24}">
                        <TextBlock Text="Forward" FontSize="11"/>
                    </ui:Button>
                    <ui:Button Appearance="Secondary" Command="{Binding CreateSnapshotCommand}" ToolTip="Bookmark current input in timeline" Margin="0,0,8,0" Padding="8,4" Icon="{ui:SymbolIcon Symbol=Camera24}">
                        <TextBlock Text="Snapshot" FontSize="11"/>
                    </ui:Button>
                    <ui:Button Appearance="Secondary" Command="{Binding LoadFileCommand}" ToolTip="Load input from file (Ctrl+O)" Margin="0,0,6,0" Padding="8,4" Icon="{ui:SymbolIcon Symbol=FolderOpen24}">
                        <TextBlock Text="Open" FontSize="11"/>
                    </ui:Button>
                    <ui:Button Appearance="Secondary" Command="{Binding ClearInputCommand}" Margin="0,0,10,0" Padding="8,4" Icon="{ui:SymbolIcon Symbol=Delete24}">
                        <TextBlock Text="Clear" FontSize="11"/>
                    </ui:Button>
                </StackPanel>

                <!-- Search Actions / Command Palette Trigger Button -->
                <Button Grid.Column="2" HorizontalAlignment="Left"
                        Command="{Binding OpenCommandPaletteCommand}"
                        ToolTip="Search actions and transformers (Ctrl+K or Ctrl+P)"
                        Background="#252526" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                        Padding="10,4" Margin="0,0,10,0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="SearchBtnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="SearchBtnBorder" Property="Background" Value="#333333"/>
                                    <Setter TargetName="SearchBtnBorder" Property="BorderBrush" Value="{DynamicResource AccentBlueBadgeBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Search24" FontSize="12" Foreground="{DynamicResource AccentBlueBadgeBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Search actions... " Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                        <Border Background="#383838" CornerRadius="3" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Ctrl+K" Foreground="#AAAAAA" FontSize="9" FontFamily="Consolas" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </Button>

                <!-- Sample Data Menu -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:DropDownButton Appearance="Secondary" Padding="8,4" Icon="{ui:SymbolIcon Symbol=Lightbulb24}">
                        <TextBlock Text="Samples" FontSize="11"/>
                        <ui:DropDownButton.Flyout>
                            <ContextMenu Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                <MenuItem Header="HTML Table (Confluence / Web)" Command="{Binding LoadSampleCommand}" CommandParameter="html" Foreground="{DynamicResource AccentSuccessBrush}"/>
                                <MenuItem Header="Numbers List (SQL IN)" Command="{Binding LoadSampleCommand}" CommandParameter="numbers"/>
                                <MenuItem Header="CSV Table Data" Command="{Binding LoadSampleCommand}" CommandParameter="csv"/>
                                <MenuItem Header="TSV Table Data (Excel)" Command="{Binding LoadSampleCommand}" CommandParameter="tsv"/>
                                <MenuItem Header="Markdown Table" Command="{Binding LoadSampleCommand}" CommandParameter="markdown"/>
                                <MenuItem Header="JSON Array of Objects" Command="{Binding LoadSampleCommand}" CommandParameter="json"/>
                                <MenuItem Header="YAML Configuration Document" Command="{Binding LoadSampleCommand}" CommandParameter="yaml"/>
                                <MenuItem Header="XML Catalog Document" Command="{Binding LoadSampleCommand}" CommandParameter="xml"/>
                                <MenuItem Header="Delimited Single Line" Command="{Binding LoadSampleCommand}" CommandParameter="delimited"/>
                                <MenuItem Header="URL Query String" Command="{Binding LoadSampleCommand}" CommandParameter="query"/>
                            </ContextMenu>
                        </ui:DropDownButton.Flyout>
                    </ui:DropDownButton>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Workspace Area -->
        <Grid Grid.Row="2" Margin="3,2,3,2">
            <Grid.ColumnDefinitions>
                <!-- Input Pane (38%) -->
                <ColumnDefinition Width="3.8*" MinWidth="250"/>
                <ColumnDefinition Width="3"/>
                <!-- Output Pane (38%) -->
                <ColumnDefinition Width="3.8*" MinWidth="250"/>
                <ColumnDefinition Width="3"/>
                <!-- Tools / Transform Options Sidebar (20%) -->
                <ColumnDefinition Width="2.7*" MinWidth="220" MaxWidth="360"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: INPUT PANE -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Pane Header -->
                    <Border Grid.Row="0" Background="{DynamicResource SurfaceHeaderBackgroundBrush}" Padding="10,6" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="INPUT" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Syntax:" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox ItemsSource="{Binding AvailableSyntaxLanguages}"
                                          SelectedItem="{Binding SelectedInputSyntax, UpdateSourceTrigger=PropertyChanged}"
                                          Width="105" Height="24" MinHeight="0" Padding="4,4" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <CheckBox Content="Wrap" IsChecked="{Binding IsInputWordWrap, Mode=TwoWay}" FontSize="10" VerticalAlignment="Center" ToolTip="Wrap lines in input editor"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <ui:Button Appearance="Primary" Command="{Binding PasteInputCommand}" Padding="6,2" FontSize="11" Margin="0,0,4,0">
                                    <TextBlock Text="Paste" FontSize="10"/>
                                </ui:Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Input Editor / History Tabs -->
                    <TabControl Grid.Row="1">
                        <!-- Tab 1: Editor -->
                        <TabItem Header="Editor">
                            <controls:BindableTextEditor x:Name="InputEditor"
                                                         BoundText="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                                         SyntaxLanguage="{Binding EffectiveInputSyntax}"
                                                         WordWrap="{Binding IsInputWordWrap}"
                                                         FontFamily="{StaticResource EditorFontFamily}"
                                                         FontSize="13"
                                                         Background="{DynamicResource EditorBackgroundBrush}"
                                                         Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </TabItem>

                        <!-- Tab 2: Timeline & History -->
                        <TabItem Header="{Binding HistoryTabHeader}">
                            <Grid Background="{DynamicResource SurfaceBackgroundBrush}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1*" MinHeight="80"/>
                                    <RowDefinition Height="4"/>
                                    <RowDefinition Height="1*" MinHeight="80"/>
                                </Grid.RowDefinitions>

                                <!-- Top: Timeline snapshots list -->
                                <Grid Grid.Row="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Filter / Search History Toolbar -->
                                    <Border Grid.Row="0" Background="{DynamicResource SurfaceHeaderBackgroundBrush}" Padding="6,4" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ui:TextBox Text="{Binding HistorySearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                                        PlaceholderText="Search timeline / snapshots..."
                                                        ClearButtonEnabled="True"
                                                        FontSize="12"/>
                                            <ui:Button Grid.Column="1" Appearance="Secondary" Command="{Binding ClearHistoryCommand}" ToolTip="Clear All History" Padding="6,2" FontSize="10" Margin="4,0,0,0">
                                                <TextBlock Text="Clear All" FontSize="10"/>
                                            </ui:Button>
                                        </Grid>
                                    </Border>

                                    <!-- History Snapshots List -->
                                    <ListBox Grid.Row="1"
                                             ItemsSource="{Binding HistoryItems}"
                                             SelectedItem="{Binding SelectedHistoryItem, Mode=TwoWay}"
                                             Background="{DynamicResource SurfaceBackgroundBrush}"
                                             BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource SurfaceCardBackgroundBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,2">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Header Line: Timestamp, Source, Bookmark -->
                                                        <Grid Grid.Row="0" Margin="0,0,0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Timestamp, StringFormat='HH:mm:ss'}" Foreground="{DynamicResource AccentSuccessBrush}" FontWeight="SemiBold" FontSize="10" Margin="0,0,6,0"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Source}" Foreground="{DynamicResource AccentInfoBrush}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="2" Text="📸" Visibility="{Binding IsSnapshot, Converter={StaticResource BooleanToVisibilityConverter}}" FontSize="10"/>
                                                        </Grid>

                                                        <!-- Snippet Preview -->
                                                        <Border Grid.Row="1" Background="{DynamicResource SurfaceDarkBackgroundBrush}" CornerRadius="2" Padding="5,3" Margin="0,0,0,4">
                                                            <TextBlock Text="{Binding Preview}" FontFamily="{StaticResource EditorFontFamily}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxHeight="45"/>
                                                        </Border>

                                                        <!-- Footer Line & Actions -->
                                                        <Grid Grid.Row="2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding SizeDisplay}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" VerticalAlignment="Center"/>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                <ui:Button Appearance="Primary" Command="{Binding DataContext.RestoreHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="6,1" FontSize="10" Margin="0,0,3,0">
                                                                    <TextBlock Text="↺ Restore" FontSize="10"/>
                                                                </ui:Button>
                                                                <ui:Button Appearance="Secondary" Command="{Binding DataContext.AppendHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="4,1" FontSize="10" Margin="0,0,3,0">
                                                                    <TextBlock Text="➕ Append" FontSize="10"/>
                                                                </ui:Button>
                                                                <ui:Button Appearance="Transparent" Command="{Binding DataContext.CopyHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Copy to Clipboard" Padding="4,1" FontSize="10" Margin="0,0,3,0" Icon="{ui:SymbolIcon Symbol=Copy24}"/>
                                                                <ui:Button Appearance="Transparent" Command="{Binding DataContext.DeleteHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Delete from History" Padding="4,1" FontSize="10" Icon="{ui:SymbolIcon Symbol=Delete24}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>

                                <GridSplitter Grid.Row="1" Height="3" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="{DynamicResource ControlStrokeColorDefaultBrush}"/>

                                <!-- Bottom: Full text preview of selected history snapshot -->
                                <Border Grid.Row="2" Background="{DynamicResource SurfaceBackgroundBrush}" Padding="6">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0" Background="{DynamicResource SurfaceHeaderBackgroundBrush}" Padding="6,4" CornerRadius="4" Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="Selected Snapshot Preview" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="11" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding SelectedHistoryItem.SizeDisplay}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <ui:Button Grid.Column="1" Appearance="Primary" Command="{Binding RestoreHistoryCommand}" CommandParameter="{Binding SelectedHistoryItem}" Padding="8,2">
                                                    <TextBlock Text="↺ Restore to Input" FontSize="10"/>
                                                </ui:Button>
                                            </Grid>
                                        </Border>

                                        <TextBox Grid.Row="1"
                                                 Text="{Binding SelectedHistoryItem.FullText, Mode=OneWay}"
                                                 IsReadOnly="True"
                                                 FontFamily="{StaticResource EditorFontFamily}"
                                                 FontSize="12"
                                                 Background="{DynamicResource SurfaceDarkBackgroundBrush}"
                                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                 BorderThickness="0"
                                                 Padding="6"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Auto"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>

                    <!-- Input Footer / Stats -->
                    <Border Grid.Row="2" Background="{DynamicResource SurfaceHeaderBackgroundBrush}" Padding="10,4" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                        <TextBlock Text="{Binding InputStats}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"/>
                    </Border>
                </Grid>
            </Border>

            <!-- GridSplitter 1 -->
            <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Center" Background="Transparent"/>

            <!-- CENTER: DATA VIEW & TEXT OUTPUT PANES (SPLIT VERTICALLY) -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <!-- Top: Table Grid View / Analysis & Stats -->
                    <RowDefinition Height="1*" MinHeight="100"/>
                    <RowDefinition Height="3"/>
                    <!-- Bottom: Dedicated Text Output Pane -->
                    <RowDefinition Height="1*" MinHeight="100"/>
                </Grid.RowDefinitions>

                <!-- TOP: TABLE GRID VIEW & ANALYSIS -->
                <Border Grid.Row="0" Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                    <TabControl SelectedIndex="{Binding SelectedCenterTabIndex, Mode=TwoWay}">
                        <!-- Tab 1: Tabular Grid View -->
                        <TabItem Header="Table Grid View" IsEnabled="{Binding HasTabularData}" ToolTipService.ShowOnDisabled="True" ToolTip="Table view is available when input contains tabular data">
                            <Grid Background="{DynamicResource SurfaceBackgroundBrush}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Grid Quick Actions Toolbar -->
                                <Border Grid.Row="0" Background="{DynamicResource SurfaceHeaderBackgroundBrush}" Padding="8,4" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Analysis.FormatDescription, StringFormat='Grid: {0}'}" Foreground="{DynamicResource AccentSuccessBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <ui:ToggleSwitch Content="Header Row"
                                                         IsChecked="{Binding HasHeaders, Mode=TwoWay}"
                                                         FontSize="11"
                                                         VerticalAlignment="Center"
                                                         ToolTip="When checked, the first row of tabular data is used for column headers. When unchecked, all rows are treated as data."/>
                                    </StackPanel>
                                </Border>

                                <!-- Interactive DataGrid -->
                                <DataGrid x:Name="PreviewDataGrid"
                                          Grid.Row="1"
                                          ItemsSource="{Binding PreviewDataTable}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserSortColumns="True"
                                          CanUserReorderColumns="True"
                                          CanUserResizeColumns="True"
                                          SelectionMode="Extended"
                                          SelectionUnit="FullRow"
                                          IsReadOnly="True"
                                          Sorting="PreviewDataGrid_Sorting"
                                          FontSize="13"
                                          RowHeight="28"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                          BorderThickness="0"
                                          Background="{DynamicResource DataGridRowBackgroundBrush}"
                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                          RowBackground="{DynamicResource DataGridRowBackgroundBrush}"
                                          AlternatingRowBackground="{DynamicResource DataGridAlternatingRowBackgroundBrush}"/>
                            </Grid>
                        </TabItem>

                        <!-- Tab 2: Structured Tree View (JSON / YAML / XML) -->
                        <TabItem Header="Structured Tree View" IsEnabled="{Binding HasStructuredData}" ToolTipService.ShowOnDisabled="True" ToolTip="Structured tree view is available when input contains JSON, YAML, or XML">
                            <Grid Background="{DynamicResource SurfaceBackgroundBrush}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Tree Quick Actions Toolbar -->
                                <Border Grid.Row="0" Background="{DynamicResource SurfaceHeaderBackgroundBrush}" Padding="8,4" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StructuredStatusText, StringFormat='Tree: {0}'}" Foreground="{DynamicResource AccentSuccessBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <ui:TextBox Text="{Binding StructuredFilterQuery, UpdateSourceTrigger=PropertyChanged}"
                                                        PlaceholderText="🔍 Filter tree..."
                                                        ClearButtonEnabled="True"
                                                        Width="150" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <ui:Button Appearance="Secondary" Command="{Binding ExpandAllStructuredNodesCommand}" ToolTip="Expand all nodes" Padding="6,2" Margin="0,0,3,0">
                                                <TextBlock Text="➕ Expand" FontSize="10"/>
                                            </ui:Button>
                                            <ui:Button Appearance="Secondary" Command="{Binding CollapseAllStructuredNodesCommand}" ToolTip="Collapse all nodes" Padding="6,2" Margin="0,0,6,0">
                                                <TextBlock Text="➖ Collapse" FontSize="10"/>
                                            </ui:Button>
                                            <ui:Button Appearance="Secondary" Command="{Binding CopyStructuredPathCommand}" ToolTip="Copy JSONPath / XPath of selected node" Padding="6,2" Margin="0,0,3,0">
                                                <TextBlock Text="📋 Path" FontSize="10"/>
                                            </ui:Button>
                                            <ui:Button Appearance="Secondary" Command="{Binding CopyStructuredValueCommand}" ToolTip="Copy value of selected node" Padding="6,2" Margin="0,0,6,0">
                                                <TextBlock Text="📋 Value" FontSize="10"/>
                                            </ui:Button>
                                            <ui:Button Appearance="Secondary" Command="{Binding ActionCommand}" CommandParameter="BeautifyJson" ToolTip="Format to JSON" Padding="6,2" Margin="0,0,3,0">
                                                <TextBlock Text="→ JSON" FontSize="10"/>
                                            </ui:Button>
                                            <ui:Button Appearance="Secondary" Command="{Binding ActionCommand}" CommandParameter="JsonToYaml" ToolTip="Convert to YAML" Padding="6,2" Margin="0,0,3,0">
                                                <TextBlock Text="→ YAML" FontSize="10"/>
                                            </ui:Button>
                                            <ui:Button Appearance="Secondary" Command="{Binding ActionCommand}" CommandParameter="JsonToXml" ToolTip="Convert to XML" Padding="6,2" Margin="0,0,3,0">
                                                <TextBlock Text="→ XML" FontSize="10"/>
                                            </ui:Button>
                                            <ui:Button Appearance="Secondary" Command="{Binding ActionCommand}" CommandParameter="FlattenStructured" ToolTip="Flatten to dot-notation paths" Padding="6,2">
                                                <TextBlock Text="→ Flat" FontSize="10"/>
                                            </ui:Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Tree View / Empty State Container -->
                                <Grid Grid.Row="1">
                                    <!-- Structured TreeView -->
                                    <TreeView x:Name="StructuredTreeView"
                                              ItemsSource="{Binding StructuredNodes}"
                                              Background="{DynamicResource SurfaceBackgroundBrush}"
                                              BorderThickness="0"
                                              Padding="4"
                                              VirtualizingStackPanel.IsVirtualizing="True"
                                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                                              Visibility="{Binding HasStructuredData, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TreeView.ItemContainerStyle>
                                            <Style TargetType="{x:Type TreeViewItem}">
                                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                                <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <Setter Property="FontSize" Value="12"/>
                                                <Setter Property="Padding" Value="2,1"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TreeView.ItemContainerStyle>
                                        <TreeView.ItemTemplate>
                                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                                <StackPanel Orientation="Horizontal" Margin="0,1" ToolTip="{Binding Path}">
                                                    <!-- Type Badge -->
                                                    <Border Background="{DynamicResource SurfaceHeaderBackgroundBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="3" Padding="3,0" Margin="0,0,5,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TypeBadge}" Foreground="{Binding TypeColorHex}" FontSize="9" FontFamily="Consolas" FontWeight="Bold"/>
                                                    </Border>
                                                    <!-- Node Name (Key / Element / Attribute) -->
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource AccentInfoBrush}" FontFamily="Consolas" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <!-- Colon Separator -->
                                                    <TextBlock Text=":" Foreground="{DynamicResource MutedTextBrush}" FontFamily="Consolas" Margin="2,0,4,0" VerticalAlignment="Center"/>
                                                    <!-- Node Value / Summary -->
                                                    <TextBlock Text="{Binding DisplayValue}" Foreground="{DynamicResource AccentWarningBrush}" FontFamily="Consolas" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </HierarchicalDataTemplate>
                                        </TreeView.ItemTemplate>
                                    </TreeView>

                                    <!-- Placeholder when No Structured Data -->
                                    <Border Visibility="{Binding HasStructuredData, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                            Background="{DynamicResource SurfaceBackgroundBrush}"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="TextBulletListTree24" FontSize="36" Foreground="{DynamicResource AccentSuccessBrush}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                            <TextBlock Text="Structured Data Viewer" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentSuccessBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                            <TextBlock Text="No structured JSON, YAML, or XML data detected in input." Foreground="{DynamicResource MutedTextBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <ui:Button Appearance="Secondary" Command="{Binding LoadSampleCommand}" CommandParameter="json" Padding="10,4" Margin="0,0,6,0">
                                                    <TextBlock Text="📄 Load Sample JSON" FontSize="11"/>
                                                </ui:Button>
                                                <ui:Button Appearance="Secondary" Command="{Binding LoadSampleCommand}" CommandParameter="yaml" Padding="10,4" Margin="0,0,6,0">
                                                    <TextBlock Text="📜 Load Sample YAML" FontSize="11"/>
                                                </ui:Button>
                                                <ui:Button Appearance="Secondary" Command="{Binding LoadSampleCommand}" CommandParameter="xml" Padding="10,4">
                                                    <TextBlock Text="📑 Load Sample XML" FontSize="11"/>
                                                </ui:Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <!-- Tab 3: Detailed Text Analysis -->
                        <TabItem Header="Analysis &amp; Stats">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="Document Statistics" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AccentBlueBadgeBrush}" Margin="0,0,0,10"/>
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="24"/>
                                            <RowDefinition Height="24"/>
                                            <RowDefinition Height="24"/>
                                            <RowDefinition Height="24"/>
                                            <RowDefinition Height="24"/>
                                            <RowDefinition Height="24"/>
                                            <RowDefinition Height="24"/>
                                            <RowDefinition Height="24"/>
                                            <RowDefinition Height="24"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Detected Structure:" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Analysis.FormatDescription}" Foreground="{DynamicResource AccentSuccessBrush}" FontWeight="Bold"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Total Characters:" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Analysis.CharacterCount}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Chars (without spaces):" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Analysis.CharacterCountNoSpaces}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Total Lines:" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Analysis.LineCount}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Non-Empty Lines:" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Analysis.NonEmptyLineCount}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Word Count:" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Analysis.WordCount}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Estimated LLM Tokens:" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Analysis.EstimatedTokens}" Foreground="{DynamicResource AccentSuccessBrush}"/>

                                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Avg Line Length:" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Analysis.AverageLineLength, StringFormat='{}{0:F1} chars'}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Est. Memory Size:" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Analysis.EstimatedByteSizeDisplay}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    </Grid>

                                    <TextBlock Text="Data &amp; Delimiter Metrics" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AccentBlueBadgeBrush}" Margin="0,0,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="24"/>
                                            <RowDefinition Height="24"/>
                                            <RowDefinition Height="24"/>
                                            <RowDefinition Height="24"/>
                                            <RowDefinition Height="24"/>
                                            <RowDefinition Height="24"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Detected Delimiter:" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Analysis.DetectedDelimiterDisplay}" Foreground="{DynamicResource AccentSuccessBrush}" FontWeight="Bold"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Detected Columns:" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Analysis.ColumnCount}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Data Rows:" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Analysis.RowCount}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Structured Nesting Depth:" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Analysis.MaxStructuredDepth}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Brackets / Quotes Balanced:" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Analysis.IsBalancedStructured}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Encoding Hint:" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Analysis.EncodingHint}" Foreground="{DynamicResource AccentSuccessBrush}"/>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Tab 4: Regex Lab & Live Match Inspector -->
                        <TabItem Header="🧪 Regex Lab">
                            <Grid Background="{DynamicResource SurfaceBackgroundBrush}">
                                <Grid.RowDefinitions>
                                    <!-- Row 0: Pattern input bar and library presets -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- Row 1: Options & Action Toolbar -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- Row 2: Status & Diagnostics Message -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- Row 3: Matches & Group Extraction Table with Side Inspector -->
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- ROW 0: PATTERN INPUT & PRESETS -->
                                <Border Grid.Row="0" Background="{DynamicResource SurfaceHeaderBackgroundBrush}" Padding="8,6" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="Pattern:" FontWeight="SemiBold" Foreground="{DynamicResource AccentBlueBadgeBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                        <ui:TextBox Grid.Column="1"
                                                    Text="{Binding RegexLabPattern, UpdateSourceTrigger=PropertyChanged}"
                                                    PlaceholderText="Enter regular expression (e.g. \b(?&lt;user&gt;[a-zA-Z0-9._%+-]+)@(?&lt;domain&gt;[a-zA-Z0-9.-]+\.[a-zA-Z]{2,})\b)"
                                                    FontFamily="{StaticResource EditorFontFamily}"
                                                    FontSize="12"
                                                    ClearButtonEnabled="True"
                                                    VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <TextBlock Text="📚 Preset:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <ComboBox ItemsSource="{Binding FilteredRegexPresets}"
                                                      SelectedItem="{Binding SelectedRegexPreset, Mode=TwoWay}"
                                                      DisplayMemberPath="Name" Padding="4,4"
                                                      Width="180" Height="26" FontSize="11" VerticalAlignment="Center"
                                                      ToolTip="Select from common tested regex patterns"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- ROW 1: OPTIONS & ACTION BUTTONS -->
                                <Border Grid.Row="1" Background="{DynamicResource SurfaceBackgroundBrush}" Padding="8,4" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Options Toggles -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Flags:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <CheckBox Content="Aa IgnoreCase (i)" IsChecked="{Binding RegexIgnoreCase, Mode=TwoWay}" FontSize="11" Margin="0,0,8,0" ToolTip="Case-insensitive matching"/>
                                            <CheckBox Content="^$ Multiline (m)" IsChecked="{Binding RegexMultiline, Mode=TwoWay}" FontSize="11" Margin="0,0,8,0" ToolTip="^ and $ match line starts and ends"/>
                                            <CheckBox Content=". Singleline (s)" IsChecked="{Binding RegexSingleline, Mode=TwoWay}" FontSize="11" Margin="0,0,8,0" ToolTip=". matches any character including newline"/>
                                            <CheckBox Content="# IgnoreWhitespace (x)" IsChecked="{Binding RegexIgnoreWhitespace, Mode=TwoWay}" FontSize="11" Margin="0,0,8,0" ToolTip="Ignore unescaped whitespace in pattern"/>
                                        </StackPanel>

                                        <!-- Extract & Clear Actions -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:DropDownButton Appearance="Primary" Padding="8,3" Margin="0,0,4,0" ToolTip="Extract regex results to output pane">
                                                <TextBlock Text="📋 Extract" FontSize="10"/>
                                                <ui:DropDownButton.Flyout>
                                                    <ContextMenu Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                                        <MenuItem Header="📋 Extract Matches" Command="{Binding ExtractRegexMatchesCommand}" ToolTip="Send all matching strings to text output pane"/>
                                                        <MenuItem Header="📊 Extract TSV Table" Command="{Binding ExtractRegexGroupsTableCommand}" ToolTip="Send extracted group table as TSV to text output pane"/>
                                                        <MenuItem Header="📦 Extract JSON" Command="{Binding ExtractRegexGroupsJsonCommand}" ToolTip="Send matches and capture groups as JSON array to output pane"/>
                                                    </ContextMenu>
                                                </ui:DropDownButton.Flyout>
                                            </ui:DropDownButton>
                                            <Button Content="✕ Clear" Command="{Binding ClearRegexPatternCommand}"
                                                    Style="{DynamicResource SecondaryToolButtonStyle}" Padding="6,3" FontSize="10"
                                                    ToolTip="Clear pattern input"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- ROW 2: STATUS & DIAGNOSTICS BAR -->
                                <Border Grid.Row="2" Background="{DynamicResource SurfaceHeaderBackgroundBrush}" Padding="8,3" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- If valid -->
                                            <TextBlock Text="{Binding RegexStatusMessage}"
                                                       FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentSuccessBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RegexHasError}" Value="True">
                                                                <Setter Property="Foreground" Value="#FF6B6B"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="{Binding SelectedRegexPreset.Description}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="350"/>
                                    </Grid>
                                </Border>

                                <!-- ROW 3: MATCH & GROUP EXTRACTION TABLE + CHEAT SHEET DRAWER -->
                                <Grid Grid.Row="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="5"/>
                                        <ColumnDefinition Width="1*" MinWidth="180" MaxWidth="350"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Group Extraction Table (DataGrid) -->
                                    <DataGrid x:Name="RegexGroupDataGrid"
                                              Grid.Column="0"
                                              ItemsSource="{Binding RegexGroupDataTable}"
                                              AutoGenerateColumns="True"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              CanUserSortColumns="True"
                                              CanUserReorderColumns="True"
                                              CanUserResizeColumns="True"
                                              SelectionMode="Single"
                                              SelectionUnit="FullRow"
                                              IsReadOnly="True"
                                              FontSize="13"
                                              RowHeight="28"
                                              GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                              BorderThickness="0"
                                              Background="{DynamicResource DataGridRowBackgroundBrush}"
                                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                              RowBackground="{DynamicResource DataGridRowBackgroundBrush}"
                                              AlternatingRowBackground="{DynamicResource DataGridAlternatingRowBackgroundBrush}"/>

                                    <!-- Splitter between table and cheat sheet -->
                                    <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Center" Background="Transparent"/>

                                    <!-- Right: Match Inspector & Regex Cheat Sheet -->
                                    <Border Grid.Column="2" Background="{DynamicResource SurfaceHeaderBackgroundBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                                            <StackPanel>
                                                <!-- Selected Match Inspector -->
                                                <TextBlock Text="Match Inspector" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentBlueBadgeBrush}" Margin="0,0,0,6"/>

                                                <ItemsControl ItemsSource="{Binding RegexMatches}" Margin="0,0,0,12">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" Padding="6" Margin="0,0,0,4">
                                                                <StackPanel>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{Binding Value, StringFormat='# {0}'}" FontWeight="SemiBold" Foreground="{DynamicResource AccentSuccessBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                                        <TextBlock Grid.Column="1" Text="{Binding Index, StringFormat='offset {0}'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10"/>
                                                                    </Grid>
                                                                    <!-- Groups breakdown -->
                                                                    <ItemsControl ItemsSource="{Binding Groups}" Margin="4,4,0,0">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Grid Margin="0,1" Visibility="{Binding Success, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock Text="{Binding DisplayName, StringFormat='{}{0}: '}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" Margin="0,0,4,0"/>
                                                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                                                                </Grid>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Regex Cheat Sheet -->
                                                <TextBlock Text="Regex Cheat Sheet" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentBlueBadgeBrush}" Margin="0,0,0,6"/>
                                                <Border Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" Padding="6">
                                                    <StackPanel TextElement.FontSize="10">
                                                        <TextBlock Text="Character Classes" FontWeight="SemiBold" Foreground="{DynamicResource AccentSuccessBrush}" Margin="0,0,0,2"/>
                                                        <TextBlock Text=". = any character (except \n)" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <TextBlock Text="\d = digit [0-9] | \D = non-digit" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <TextBlock Text="\w = word char [a-zA-Z0-9_]" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <TextBlock Text="\s = whitespace | \S = non-space" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                                                        <TextBlock Text="Anchors &amp; Boundaries" FontWeight="SemiBold" Foreground="{DynamicResource AccentSuccessBrush}" Margin="0,6,0,2"/>
                                                        <TextBlock Text="^ = line start | $ = line end" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <TextBlock Text="\b = word boundary | \B = non-boundary" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                                                        <TextBlock Text="Quantifiers" FontWeight="SemiBold" Foreground="{DynamicResource AccentSuccessBrush}" Margin="0,6,0,2"/>
                                                        <TextBlock Text="+ = 1 or more | * = 0 or more" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <TextBlock Text="? = 0 or 1 | {n,m} = between n and m" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <TextBlock Text="+? or *? = lazy / non-greedy" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                                                        <TextBlock Text="Groups &amp; Lookaround" FontWeight="SemiBold" Foreground="{DynamicResource AccentSuccessBrush}" Margin="0,6,0,2"/>
                                                        <TextBlock Text="(?&lt;name&gt;...) = named capture group" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <TextBlock Text="(?:...) = non-capturing group" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <TextBlock Text="(?=...) = positive lookahead" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <TextBlock Text="(?!...) = negative lookahead" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <!-- Tab 5: Roslyn / C# Scripting & LINQ Scratchpad -->
                        <TabItem Header="💻 C# Scratchpad">
                            <Grid Background="{DynamicResource SurfaceBackgroundBrush}">
                                <Grid.RowDefinitions>
                                    <!-- Row 0: Toolbar & Preset Selector -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- Row 1: Status & Diagnostics Message -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- Row 2: Two-Pane Script Editor & Live Result Output -->
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- ROW 0: TOOLBAR & PRESETS -->
                                <Border Grid.Row="0" Background="{DynamicResource SurfaceHeaderBackgroundBrush}" Padding="8,6" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Preset Selector -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="📚 Preset:" FontWeight="SemiBold" Foreground="{DynamicResource AccentBlueBadgeBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <ComboBox ItemsSource="{Binding FilteredScriptPresets}"
                                                      SelectedItem="{Binding SelectedScriptPreset, Mode=TwoWay}"
                                                      DisplayMemberPath="Title" Padding="4,4"
                                                      Width="220" Height="26" FontSize="11" VerticalAlignment="Center"
                                                      ToolTip="Select a built-in C# / LINQ transformation preset"/>
                                            <Button Content="🧪 Sample" Command="{Binding LoadScriptSampleInputCommand}"
                                                    Style="{DynamicResource SecondaryToolButtonStyle}" Margin="4,0,0,0" Padding="6,3" FontSize="10"
                                                    ToolTip="Load sample input text for the selected script preset into the editor"/>
                                        </StackPanel>

                                        <!-- Center: Quick Globals Hint -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <Border Background="{DynamicResource BadgeBackgroundBrush}" CornerRadius="3" Padding="5,2" VerticalAlignment="Center" ToolTip="Available host globals: input (string), text (string), lines (string[]), nonEmptyLines (string[]), print(val), dump(val)">
                                                <TextBlock Text="💡 Globals: input, lines, nonEmptyLines, print(), dump()" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" FontFamily="Consolas"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Action Buttons -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox Content="⚡ Live Eval" IsChecked="{Binding IsScriptLiveEvaluation, Mode=TwoWay}" FontSize="11" Margin="0,0,8,0" ToolTip="Automatically evaluate script on every keystroke or input change"/>
                                            <Button Content="▶ Run" Command="{Binding ExecuteCSharpScriptCommand}"
                                                    Style="{StaticResource PrimaryToolButtonStyle}" Margin="0,0,4,0" Padding="8,3" FontSize="10"
                                                    ToolTip="Execute current C# script expression (F5)"/>
                                            <Button Content="⬆ To Input" Command="{Binding SendScriptOutputToInputCommand}"
                                                    IsEnabled="{Binding HasScriptOutput}"
                                                    Style="{DynamicResource SecondaryToolButtonStyle}" Margin="0,0,4,0" Padding="8,3" FontSize="10"
                                                    ToolTip="Send script output directly to input editor"/>
                                            <Button Content="📋 To Output" Command="{Binding SendScriptOutputToOutputCommand}"
                                                    IsEnabled="{Binding HasScriptOutput}"
                                                    Style="{DynamicResource SecondaryToolButtonStyle}" Margin="0,0,4,0" Padding="8,3" FontSize="10"
                                                    ToolTip="Send script output to main text output editor"/>
                                            <Button Content="✕ Clear" Command="{Binding ClearCSharpScriptCommand}"
                                                    Style="{DynamicResource SecondaryToolButtonStyle}" Padding="6,3" FontSize="10"
                                                    ToolTip="Clear script editor"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- ROW 1: STATUS & DIAGNOSTICS BAR -->
                                <Border Grid.Row="1" Background="{DynamicResource SurfaceBackgroundBrush}" Padding="8,4" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ScriptStatusSummary}"
                                                       FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentSuccessBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ScriptHasError}" Value="True">
                                                                <Setter Property="Foreground" Value="#FF6B6B"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="{Binding SelectedScriptPreset.Description}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="400"/>
                                    </Grid>
                                </Border>

                                <!-- ROW 2: SPLIT SCRIPT EDITOR & OUTPUT PREVIEW -->
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="5"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: C# Script Editor -->
                                    <Border Grid.Column="0" Background="{DynamicResource SurfaceBackgroundBrush}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <Border Grid.Row="0" Background="{DynamicResource SurfaceHeaderBackgroundBrush}" Padding="8,4" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="C# / LINQ EXPRESSION" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10"/>
                                                    <TextBlock Grid.Column="1" Text="Type expression or code block" Foreground="{DynamicResource MutedTextBrush}" FontSize="10"/>
                                                </Grid>
                                            </Border>

                                            <controls:BindableTextEditor x:Name="CSharpScriptEditor"
                                                                         Grid.Row="1"
                                                                         BoundText="{Binding CSharpScript, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                         SyntaxLanguage="C#"
                                                                         FontFamily="{StaticResource EditorFontFamily}"
                                                                         FontSize="13"
                                                                         Background="{DynamicResource EditorBackgroundBrush}"
                                                                         Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        </Grid>
                                    </Border>

                                    <!-- Splitter between Editor and Output -->
                                    <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Center" Background="Transparent"/>

                                    <!-- Right: Script Output / Results -->
                                    <Border Grid.Column="2" Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <Border Grid.Row="0" Background="{DynamicResource SurfaceHeaderBackgroundBrush}" Padding="8,4" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="EVALUATION OUTPUT" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" Margin="0,0,8,0"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Background="{DynamicResource BadgeBackgroundBrush}" CornerRadius="3" Padding="4,1" Margin="0,0,4,0" Visibility="{Binding ScriptReturnTypeName, Converter={StaticResource StringToVisibilityConverter}}">
                                                            <TextBlock Text="{Binding ScriptReturnTypeName}" Foreground="{DynamicResource AccentBlueBadgeBrush}" FontSize="9" FontFamily="Consolas"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding ScriptExecutionTimeMs, StringFormat='{}{0:F2}ms'}" Foreground="{DynamicResource AccentSuccessBrush}" FontSize="10" FontWeight="SemiBold"/>
                                                </Grid>
                                            </Border>

                                            <!-- Output text editor (read-only view) -->
                                            <controls:BindableTextEditor x:Name="ScriptOutputEditor"
                                                                         Grid.Row="1"
                                                                         BoundText="{Binding ScriptOutput, Mode=OneWay}"
                                                                         SyntaxLanguage="Auto"
                                                                         IsReadOnly="True"
                                                                         FontFamily="{StaticResource EditorFontFamily}"
                                                                         FontSize="13"
                                                                         Background="{DynamicResource EditorBackgroundBrush}"
                                                                         Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Border>

                <!-- GridSplitter 2 (Vertical split between Table and Output) -->
                <GridSplitter Grid.Row="1" Height="3" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent"/>

                <!-- BOTTOM: DEDICATED TEXT OUTPUT PANE -->
                <Border Grid.Row="2" Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Output Pane Header -->
                        <Border Grid.Row="0" Background="{DynamicResource SurfaceHeaderBackgroundBrush}" Padding="10,6" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="OUTPUT" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Syntax:" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <ComboBox ItemsSource="{Binding AvailableSyntaxLanguages}"
                                              SelectedItem="{Binding SelectedOutputSyntax, UpdateSourceTrigger=PropertyChanged}"
                                              Width="105" Height="24" MinHeight="0" Padding="4,4" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <CheckBox Content="Wrap" IsChecked="{Binding IsOutputWordWrap, Mode=TwoWay}" FontSize="10" VerticalAlignment="Center" ToolTip="Wrap lines in output editor"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <ui:Button Appearance="Success" Command="{Binding SendToInputCommand}" IsEnabled="{Binding CanSendOutputToInput}" ToolTip="Send output directly to input editor (Ctrl+Shift+I / Alt+I / F4)" Padding="12,3" Margin="0,0,6,0" Icon="{ui:SymbolIcon Symbol=ArrowUp24}">
                                        <TextBlock Text="Send to Input" FontWeight="SemiBold" FontSize="11"/>
                                    </ui:Button>
                                    <ui:Button Appearance="Primary" Command="{Binding CopyOutputCommand}" IsEnabled="{Binding CanSendOutputToInput}" ToolTip="Copy transformed text to Clipboard" Padding="8,3" Margin="0,0,4,0" Icon="{ui:SymbolIcon Symbol=Copy24}">
                                    </ui:Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Output Bindable Text Editor -->
                        <controls:BindableTextEditor x:Name="OutputEditor"
                                                     Grid.Row="1"
                                                     BoundText="{Binding OutputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     SyntaxLanguage="{Binding EffectiveOutputSyntax}"
                                                     WordWrap="{Binding IsOutputWordWrap}"
                                                     FontFamily="{StaticResource EditorFontFamily}"
                                                     FontSize="13"
                                                     Background="{DynamicResource EditorBackgroundBrush}"
                                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                        <!-- Output Footer / Stats -->
                        <Border Grid.Row="2" Background="{DynamicResource SurfaceHeaderBackgroundBrush}" Padding="10,4" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                            <TextBlock Text="{Binding OutputStats}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- GridSplitter 3 -->
            <GridSplitter Grid.Column="3" Width="3" HorizontalAlignment="Center" Background="Transparent"/>

            <!-- RIGHT: TOOLS / TRANSFORM OPTIONS SIDEBAR -->
            <Border Grid.Column="4" Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Sidebar Header -->
                    <Border Grid.Row="0" Background="{DynamicResource SurfaceHeaderBackgroundBrush}" Padding="10,6" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="TRANSFORM OPTIONS" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="11"/>
                    </Border>

                    <!-- Sidebar Category Tabs -->
                    <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedSidebarTabIndex, Mode=TwoWay}">
                        <!-- TAB 1: LINE OPERATIONS -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📐 Lines" FontSize="11" VerticalAlignment="Center"/>
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentSuccessBrush}" Margin="5,0,0,0" VerticalAlignment="Center"
                                             Visibility="{Binding IsLinesTabHighlighted, Converter={StaticResource BooleanToVisibilityConverter}}"
                                             ToolTip="Recommended for current input format"/>
                                </StackPanel>
                            </TabItem.Header>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                                <StackPanel>
                                    <!-- Join Lines -->
                                    <Expander Header="Join Lines" controls:SectionState.Key="Lines_JoinLines" Style="{StaticResource SectionExpanderStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Delim:" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,4,0" FontSize="10"/>
                                            <ui:TextBox Grid.Column="1" Text="{Binding JoinDelimiter, UpdateSourceTrigger=PropertyChanged}" ClearButtonEnabled="False" FontSize="11" Margin="0,0,4,0"/>
                                            <Button Grid.Column="2" Content="🔗 Join Lines" Command="{Binding ActionCommand}" CommandParameter="JoinLines" Style="{StaticResource PrimaryToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                        </Grid>
                                    </Expander>

                                    <!-- Split Lines -->
                                    <Expander Header="Split Delimited Line" controls:SectionState.Key="Lines_SplitDelimitedLine" Style="{StaticResource SectionExpanderStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Split:" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,4,0" FontSize="10"/>
                                            <ui:TextBox Grid.Column="1" Text="{Binding SplitDelimiter, UpdateSourceTrigger=PropertyChanged}" ClearButtonEnabled="False" FontSize="11" Margin="0,0,4,0"/>
                                            <Button Grid.Column="2" Content="✂️ Split Lines" Command="{Binding ActionCommand}" CommandParameter="SplitLine" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                        </Grid>
                                    </Expander>

                                    <!-- Quote Lines -->
                                    <Expander Header="Quote Lines" controls:SectionState.Key="Lines_QuoteLines" Style="{StaticResource SectionExpanderStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0" SelectedValue="{Binding QuoteStyle, Mode=TwoWay}" SelectedValuePath="Tag" FontSize="11" Margin="0,0,4,0">
                                                <ComboBoxItem Content="'Single Quotes'" Tag="{x:Static line:QuoteStyle.SingleQuotes}"/>
                                                <ComboBoxItem Content="&quot;Double Quotes&quot;" Tag="{x:Static line:QuoteStyle.DoubleQuotes}"/>
                                                <ComboBoxItem Content="`Backticks`" Tag="{x:Static line:QuoteStyle.Backticks}"/>
                                                <ComboBoxItem Content="[Square Brackets]" Tag="{x:Static line:QuoteStyle.SquareBrackets}"/>
                                                <ComboBoxItem Content="(Parentheses)" Tag="{x:Static line:QuoteStyle.Parentheses}"/>
                                                <ComboBoxItem Content="{}{Curly Braces}" Tag="{x:Static line:QuoteStyle.CurlyBraces}"/>
                                            </ComboBox>
                                            <Button Grid.Column="1" Content="💬 Quote" Command="{Binding ActionCommand}" CommandParameter="QuoteLines" Style="{StaticResource ToolButtonStyle}" Padding="10,4" HorizontalContentAlignment="Center"/>
                                        </Grid>
                                    </Expander>

                                    <!-- Prefix / Suffix -->
                                    <Expander Header="Prefix / Suffix" controls:SectionState.Key="Lines_PrefixSuffix" Style="{StaticResource SectionExpanderStyle}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Pre:" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" FontSize="10"/>
                                                <ui:TextBox Grid.Column="1" Text="{Binding LinePrefix, UpdateSourceTrigger=PropertyChanged}" ClearButtonEnabled="False" FontSize="11" Margin="0,0,4,0"/>
                                                <CheckBox Grid.Column="2" Content="1st" IsChecked="{Binding LinePrefixSkipFirst, Mode=TwoWay}" Foreground="{DynamicResource MutedTextBrush}" FontSize="9.5" ToolTip="Skip first line" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                <CheckBox Grid.Column="3" Content="last" IsChecked="{Binding LinePrefixSkipLast, Mode=TwoWay}" Foreground="{DynamicResource MutedTextBrush}" FontSize="9.5" ToolTip="Skip last line" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Suf:" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" FontSize="10"/>
                                                <ui:TextBox Grid.Column="1" Text="{Binding LineSuffix, UpdateSourceTrigger=PropertyChanged}" ClearButtonEnabled="False" FontSize="11" Margin="0,0,4,0"/>
                                                <CheckBox Grid.Column="2" Content="1st" IsChecked="{Binding LineSuffixSkipFirst, Mode=TwoWay}" Foreground="{DynamicResource MutedTextBrush}" FontSize="9.5" ToolTip="Skip first line" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                <CheckBox Grid.Column="3" Content="last" IsChecked="{Binding LineSuffixSkipLast, Mode=TwoWay}" Foreground="{DynamicResource MutedTextBrush}" FontSize="9.5" ToolTip="Skip last line" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Button Content="➕ Add Prefix / Suffix" Command="{Binding ActionCommand}" CommandParameter="PrefixSuffix" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                        </StackPanel>
                                    </Expander>

                                    <!-- Find & Replace in Lines -->
                                    <Expander Header="Find &amp; Replace" controls:SectionState.Key="Lines_FindReplace" Style="{StaticResource SectionExpanderStyle}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Find:" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" FontSize="10"/>
                                                <ui:TextBox Grid.Column="1" Text="{Binding LineFind, UpdateSourceTrigger=PropertyChanged}" ClearButtonEnabled="False" FontSize="11"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Repl:" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" FontSize="10"/>
                                                <ui:TextBox Grid.Column="1" Text="{Binding LineReplace, UpdateSourceTrigger=PropertyChanged}" ClearButtonEnabled="False" FontSize="11"/>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <CheckBox Content="Case" IsChecked="{Binding LineReplaceCaseSensitive, Mode=TwoWay}" Foreground="{DynamicResource MutedTextBrush}" FontSize="9.5" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                    <CheckBox Content="Regex" IsChecked="{Binding LineReplaceIsRegex, Mode=TwoWay}" Foreground="{DynamicResource MutedTextBrush}" FontSize="9.5" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="🔄 Replace" Command="{Binding ActionCommand}" CommandParameter="ReplaceInLines" Style="{StaticResource ToolButtonStyle}" Padding="8,3" HorizontalContentAlignment="Center"/>
                                            </Grid>
                                        </StackPanel>
                                    </Expander>

                                    <!-- Sort & Deduplicate -->
                                    <Expander Header="Sort &amp; Deduplicate" controls:SectionState.Key="Lines_SortDeduplicate" Style="{StaticResource SectionExpanderStyle}">
                                        <StackPanel>
                                            <ComboBox SelectedValue="{Binding SortOrder, Mode=TwoWay}" SelectedValuePath="Tag" FontSize="11" Margin="0,0,0,3">
                                                <ComboBoxItem Content="Natural Numeric (1, 2, 10)" Tag="{x:Static line:SortOrder.NaturalNumericAsc}"/>
                                                <ComboBoxItem Content="Natural Numeric Desc" Tag="{x:Static line:SortOrder.NaturalNumericDesc}"/>
                                                <ComboBoxItem Content="A-Z (Ascending)" Tag="{x:Static line:SortOrder.AlphabeticalAsc}"/>
                                                <ComboBoxItem Content="Z-A (Descending)" Tag="{x:Static line:SortOrder.AlphabeticalDesc}"/>
                                                <ComboBoxItem Content="Case Insensitive A-Z" Tag="{x:Static line:SortOrder.CaseInsensitiveAsc}"/>
                                                <ComboBoxItem Content="Case Insensitive Z-A" Tag="{x:Static line:SortOrder.CaseInsensitiveDesc}"/>
                                                <ComboBoxItem Content="By Length (Short→Long)" Tag="{x:Static line:SortOrder.LengthAsc}"/>
                                                <ComboBoxItem Content="By Length (Long→Short)" Tag="{x:Static line:SortOrder.LengthDesc}"/>
                                                <ComboBoxItem Content="Reverse Order" Tag="{x:Static line:SortOrder.Reverse}"/>
                                            </ComboBox>
                                            <UniformGrid Columns="2">
                                                <Button Content="🔤 Sort Lines" Command="{Binding ActionCommand}" CommandParameter="SortLines" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                                <Button Content="🧹 Remove Dupes" Command="{Binding ActionCommand}" CommandParameter="RemoveDuplicates" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Expander>

                                    <!-- Filter, Trim & Number -->
                                    <Expander Header="Filter, Trim &amp; Number" controls:SectionState.Key="Lines_FilterTrimNumber" Style="{StaticResource SectionExpanderStyle}">
                                        <StackPanel>
                                            <UniformGrid Columns="2">
                                                <Button Content="🧹 Trim" Command="{Binding ActionCommand}" CommandParameter="TrimLines" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                                <Button Content="🗑 No Empty" Command="{Binding ActionCommand}" CommandParameter="RemoveEmptyLines" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                                <Button Content="🔢 Number Lines" Command="{Binding ActionCommand}" CommandParameter="NumberLines" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                                <Button Content="🚫 No Numbers" Command="{Binding ActionCommand}" CommandParameter="RemoveLineNumbers" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                                <Button Content="🔠 Pad Start" Command="{Binding ActionCommand}" CommandParameter="PadStart" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                                <Button Content="🔡 Pad End" Command="{Binding ActionCommand}" CommandParameter="PadEnd" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            </UniformGrid>
                                            <Grid Margin="0,3,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ui:TextBox Grid.Column="0" Text="{Binding FilterPattern, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Filter pattern..." ClearButtonEnabled="False" FontSize="11"/>
                                                <Button Grid.Column="1" Content="Keep" Command="{Binding ActionCommand}" CommandParameter="FilterKeepMatching" Style="{StaticResource ToolButtonStyle}" Padding="8,3" Margin="3,0,0,0" HorizontalContentAlignment="Center"/>
                                            </Grid>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- TAB 2: TABLE & CSV OPERATIONS -->
                        <TabItem IsEnabled="{Binding HasTabularData}" ToolTipService.ShowOnDisabled="True" ToolTip="Table operations are available when input contains tabular data">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📊 Table" FontSize="11" VerticalAlignment="Center"/>
                                    <Ellipse Width="6" Height="6" Fill="#4EC9B0" Margin="5,0,0,0" VerticalAlignment="Center"
                                             Visibility="{Binding IsTableTabHighlighted, Converter={StaticResource BooleanToVisibilityConverter}}"
                                             ToolTip="Recommended for current input format"/>
                                </StackPanel>
                            </TabItem.Header>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                                <StackPanel>
                                    <!-- Column Selection & Extraction -->
                                    <Expander Header="Column Selection &amp; Extract" IsExpanded="True" controls:SectionState.Key="Tabular_ColumnSelectionExtract" Style="{StaticResource SectionExpanderStyle}">
                                        <StackPanel>
                                            <!-- Surrogate / Override Headers -->
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ui:TextBox Grid.Column="0"
                                                            Text="{Binding SurrogateHeaders, UpdateSourceTrigger=PropertyChanged}"
                                                            PlaceholderText="Override headers (col1, col2)..."
                                                            ClearButtonEnabled="False"
                                                            FontSize="11"
                                                            ToolTip="Surrogate / override column headers (comma or delimited)"/>
                                                <ui:Button Grid.Column="1"
                                                           Appearance="Secondary"
                                                           Command="{Binding ActionCommand}"
                                                           CommandParameter="GenerateSurrogateHeaders"
                                                           ToolTip="Auto-generate Col1, Col2, ... headers"
                                                           Padding="6,2"
                                                           Margin="3,0,0,0">
                                                    <TextBlock Text="Auto" FontSize="10"/>
                                                </ui:Button>
                                            </Grid>

                                            <!-- Column Selector Panel -->
                                            <Border Background="{DynamicResource SurfaceCardBackgroundBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,4">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <Border Grid.Row="0" Background="{DynamicResource ControlFillColorSecondaryBrush}" Padding="5,3" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" CornerRadius="4,4,0,0">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="Columns" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="10.5" VerticalAlignment="Center"/>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                <ui:Button Appearance="Transparent" Command="{Binding SelectAllColumnsCommand}" Padding="4,1" Margin="0,0,2,0">
                                                                    <TextBlock Text="All" FontSize="9"/>
                                                                </ui:Button>
                                                                <ui:Button Appearance="Transparent" Command="{Binding DeselectAllColumnsCommand}" Padding="4,1" Margin="0,0,2,0">
                                                                    <TextBlock Text="None" FontSize="9"/>
                                                                </ui:Button>
                                                                <ui:Button Appearance="Transparent" Command="{Binding InvertColumnsCommand}" Padding="4,1">
                                                                    <TextBlock Text="Invert" FontSize="9"/>
                                                                </ui:Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                    <ListBox Grid.Row="1"
                                                             ItemsSource="{Binding ColumnItems}"
                                                             Background="Transparent"
                                                             BorderThickness="0"
                                                             Padding="2"
                                                             MaxHeight="140"
                                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                        <ListBox.ItemContainerStyle>
                                                            <Style TargetType="ListBoxItem">
                                                                <Setter Property="Padding" Value="3,1"/>
                                                                <Setter Property="Margin" Value="0,1"/>
                                                                <Setter Property="MinHeight" Value="0"/>
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="ListBoxItem">
                                                                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="true" CornerRadius="3">
                                                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter Property="Background" TargetName="Bd" Value="{DynamicResource ControlStrongFillColorDefaultBrush}"/>
                                                                                </Trigger>
                                                                                <Trigger Property="IsSelected" Value="True">
                                                                                    <Setter Property="Background" TargetName="Bd" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </ListBox.ItemContainerStyle>
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                          Margin="0"
                                                                          ToolTip="{Binding DisplayText}"
                                                                          VerticalContentAlignment="Center">
                                                                    <StackPanel Orientation="Horizontal" Margin="3,0,0,0" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding DisplayIndex, StringFormat='[{0}] '}" Foreground="{DynamicResource MutedTextBrush}" FontSize="9.5" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="10.5" TextTrimming="CharacterEllipsis" MaxWidth="110" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="{Binding SampleValue, StringFormat=' ({0})'}"
                                                                                   Foreground="{DynamicResource DimTextBrush}"
                                                                                   FontSize="9"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   MaxWidth="95"
                                                                                   Visibility="{Binding HasSampleValue, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                                   VerticalAlignment="Center"
                                                                                   Margin="2,0,0,0"/>
                                                                    </StackPanel>
                                                                </CheckBox>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </Grid>
                                            </Border>

                                            <UniformGrid Columns="2">
                                                <Button Content="📋 Lines" Command="{Binding ActionCommand}" CommandParameter="ExtractSelectedToLines" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                                <Button Content="🔍 SQL IN" Command="{Binding ActionCommand}" CommandParameter="ExtractSelectedToSql" Style="{StaticResource PrimaryToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                                <Button Content="📊 CSV" Command="{Binding ActionCommand}" CommandParameter="ExtractSelectedToCsv" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                                <Button Content="📊 TSV" Command="{Binding ActionCommand}" CommandParameter="ExtractSelectedToTsv" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                                <Button Content="📝 Markdown" Command="{Binding ActionCommand}" CommandParameter="ExtractSelectedToMarkdown" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                                <Button Content="🌐 HTML" Command="{Binding ActionCommand}" CommandParameter="ExtractSelectedToHtml" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                                <Button Content="📦 JSON" Command="{Binding ActionCommand}" CommandParameter="ExtractSelectedToJson" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                                <Button Content="📜 YAML" Command="{Binding ActionCommand}" CommandParameter="ExtractSelectedToYaml" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Expander>

                                    <!-- Column Case Conversion -->
                                    <Expander Header="Column Case Conversion" controls:SectionState.Key="Tabular_ColumnCaseConversion" Style="{StaticResource SectionExpanderStyle}">
                                        <UniformGrid Columns="2">
                                            <Button Content="UPPERCASE" Command="{Binding ActionCommand}" CommandParameter="TransformSelectedUpperCase" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="lowercase" Command="{Binding ActionCommand}" CommandParameter="TransformSelectedLowerCase" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="Title Case" Command="{Binding ActionCommand}" CommandParameter="TransformSelectedTitleCase" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="camelCase" Command="{Binding ActionCommand}" CommandParameter="TransformSelectedCamelCase" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="PascalCase" Command="{Binding ActionCommand}" CommandParameter="TransformSelectedPascalCase" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="snake_case" Command="{Binding ActionCommand}" CommandParameter="TransformSelectedSnakeCase" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                        </UniformGrid>
                                    </Expander>

                                    <!-- Column Prefix / Suffix & Replace -->
                                    <Expander Header="Column Prefix / Suffix &amp; Replace" controls:SectionState.Key="Tabular_ColumnPrefixSuffixReplace" Style="{StaticResource SectionExpanderStyle}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <ui:TextBox Grid.Column="0" Text="{Binding TableColumnPrefix, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Prefix..." ClearButtonEnabled="False" FontSize="11" Margin="0,0,2,0"/>
                                                <ui:TextBox Grid.Column="1" Text="{Binding TableColumnSuffix, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Suffix..." ClearButtonEnabled="False" FontSize="11" Margin="2,0,0,0"/>
                                            </Grid>
                                            <Button Content="➕ Add Prefix/Suffix to Cols" Command="{Binding ActionCommand}" CommandParameter="TransformSelectedPrefixSuffix" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center" Margin="0,0,0,3"/>

                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <ui:TextBox Grid.Column="0" Text="{Binding TableColumnFind, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Find..." ClearButtonEnabled="False" FontSize="11" Margin="0,0,2,0"/>
                                                <ui:TextBox Grid.Column="1" Text="{Binding TableColumnReplaceWith, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Replace..." ClearButtonEnabled="False" FontSize="11" Margin="2,0,0,0"/>
                                            </Grid>
                                            <Button Content="🔄 Find &amp; Replace in Cols" Command="{Binding ActionCommand}" CommandParameter="TransformSelectedReplace" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                        </StackPanel>
                                    </Expander>

                                    <!-- Table Restructure & Filter -->
                                    <Expander Header="Table Structure &amp; Filter" controls:SectionState.Key="Tabular_TableStructureFilter" Style="{StaticResource SectionExpanderStyle}">
                                        <StackPanel>
                                            <UniformGrid Columns="2">
                                                <Button Content="📌 Keep Cols" Command="{Binding ActionCommand}" CommandParameter="KeepOnlySelectedColumns" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                                <Button Content="🗑️ Drop Cols" Command="{Binding ActionCommand}" CommandParameter="DropSelectedColumns" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            </UniformGrid>
                                            <Grid Margin="0,3,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ui:TextBox Grid.Column="0" Text="{Binding TableFilterQuery, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Filter rows by col..." ClearButtonEnabled="False" FontSize="11"/>
                                                <Button Grid.Column="1" Content="🔍 Filter" Command="{Binding ActionCommand}" CommandParameter="FilterTableByColumn" Style="{StaticResource ToolButtonStyle}" Padding="8,3" Margin="3,0,0,0" HorizontalContentAlignment="Center"/>
                                            </Grid>
                                            <UniformGrid Columns="2">
                                                <Button Content="📶 Sort by Col" Command="{Binding ActionCommand}" CommandParameter="SortTableByColumn" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                                <Button Content="🔄 Transpose" Command="{Binding ActionCommand}" CommandParameter="TransposeTable" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Expander>

                                    <!-- Key-Value Generator -->
                                    <Expander Header="Key-Value Generator" controls:SectionState.Key="Tabular_KeyValueGenerator" Style="{StaticResource SectionExpanderStyle}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid Grid.Column="0" Margin="0,0,2,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="K:" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,0,3,0"/>
                                                    <ComboBox Grid.Column="1" ItemsSource="{Binding DetectedColumns}" SelectedItem="{Binding SelectedKeyColumn, Mode=TwoWay}" FontSize="11"/>
                                                </Grid>
                                                <Grid Grid.Column="1" Margin="2,0,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="V:" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,0,3,0"/>
                                                    <ComboBox Grid.Column="1" ItemsSource="{Binding DetectedColumns}" SelectedItem="{Binding SelectedValueColumn, Mode=TwoWay}" FontSize="11"/>
                                                </Grid>
                                            </Grid>
                                            <CheckBox Content="Include other columns in value"
                                                      IsChecked="{Binding KeyValueIncludeRestOfColumns, UpdateSourceTrigger=PropertyChanged}"
                                                      Foreground="{DynamicResource MutedTextBrush}"
                                                      FontSize="10"
                                                      Margin="0,0,0,3"
                                                      ToolTip="When checked, the value is an object or map containing all other properties and columns instead of a single column."/>
                                            <UniformGrid Columns="3">
                                                <Button Content="📦 JSON" Command="{Binding ActionCommand}" CommandParameter="TableToKeyValueJson" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                                <Button Content="📜 YAML" Command="{Binding ActionCommand}" CommandParameter="TableToKeyValueYaml" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                                <Button Content="🔗 Query" Command="{Binding ActionCommand}" CommandParameter="TableToKeyValueQuery" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Expander>

                                    <!-- Whole Table Conversions -->
                                    <Expander Header="Full Table Conversions" controls:SectionState.Key="Tabular_FullTableConversions" Style="{StaticResource SectionExpanderStyle}">
                                        <UniformGrid Columns="2">
                                            <Button Content="📝 Markdown" Command="{Binding ActionCommand}" CommandParameter="ToMarkdownTable" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="🌐 HTML Table" Command="{Binding ActionCommand}" CommandParameter="ToHtmlTable" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="📊 CSV (Comma)" Command="{Binding ActionCommand}" CommandParameter="ToCsv" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="📊 TSV (Tab)" Command="{Binding ActionCommand}" CommandParameter="ToTsv" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="📦 JSON (Obj)" Command="{Binding ActionCommand}" CommandParameter="ToJsonObjects" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="📜 YAML (Obj)" Command="{Binding ActionCommand}" CommandParameter="ToYaml" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="📦 JSON (Arr)" Command="{Binding ActionCommand}" CommandParameter="ToJsonArrays" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="📜 YAML (Arr)" Command="{Binding ActionCommand}" CommandParameter="ToYamlArrays" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                        </UniformGrid>
                                    </Expander>

                                    <!-- SQL INSERT -->
                                    <Expander Header="SQL INSERT Statements" controls:SectionState.Key="Tabular_SqlInsertStatements" Style="{StaticResource SectionExpanderStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Table:" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,4,0" FontSize="10"/>
                                            <ui:TextBox Grid.Column="1" Text="{Binding SqlTableName, UpdateSourceTrigger=PropertyChanged}" ClearButtonEnabled="False" FontSize="11" Margin="0,0,4,0"/>
                                            <Button Grid.Column="2" Content="💾 Generate" Command="{Binding ActionCommand}" CommandParameter="ToSqlInserts" Style="{StaticResource PrimaryToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                        </Grid>
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- TAB 3: STRUCTURED DATA (JSON / YAML / XML) -->
                        <TabItem IsEnabled="{Binding HasStructuredData}" ToolTipService.ShowOnDisabled="True" ToolTip="Structured operations are available when input contains JSON, YAML, or XML">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🌳 Structured" FontSize="11" VerticalAlignment="Center"/>
                                    <Ellipse Width="6" Height="6" Fill="#4EC9B0" Margin="5,0,0,0" VerticalAlignment="Center"
                                             Visibility="{Binding IsStructuredTabHighlighted, Converter={StaticResource BooleanToVisibilityConverter}}"
                                             ToolTip="Recommended for current input format"/>
                                </StackPanel>
                            </TabItem.Header>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                                <StackPanel>
                                    <!-- Format Conversions -->
                                    <Expander Header="Format Conversions" controls:SectionState.Key="Structured_FormatConversions" Style="{StaticResource SectionExpanderStyle}">
                                        <UniformGrid Columns="2">
                                            <Button Content="🔄 JSON ➔ YAML" Command="{Binding ActionCommand}" CommandParameter="JsonToYaml" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="🔄 YAML ➔ JSON" Command="{Binding ActionCommand}" CommandParameter="YamlToJson" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="🔄 XML ➔ JSON" Command="{Binding ActionCommand}" CommandParameter="XmlToJson" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="🔄 JSON ➔ XML" Command="{Binding ActionCommand}" CommandParameter="JsonToXml" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="🔄 XML ➔ YAML" Command="{Binding ActionCommand}" CommandParameter="XmlToYaml" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="🔄 YAML ➔ XML" Command="{Binding ActionCommand}" CommandParameter="YamlToXml" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="📊 → CSV" Command="{Binding ActionCommand}" CommandParameter="StructuredToCsv" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="📊 → TSV" Command="{Binding ActionCommand}" CommandParameter="StructuredToTsv" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="📝 → Markdown" Command="{Binding ActionCommand}" CommandParameter="StructuredToMarkdown" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="🌐 → HTML Table" Command="{Binding ActionCommand}" CommandParameter="StructuredToHtml" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="✨ Auto Beautify" Command="{Binding ActionCommand}" CommandParameter="Beautify" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                        </UniformGrid>
                                    </Expander>

                                    <!-- Key Casing & Renaming -->
                                    <Expander Header="Key Casing &amp; Renaming" controls:SectionState.Key="Structured_KeyCasing" Style="{StaticResource SectionExpanderStyle}">
                                        <UniformGrid Columns="2">
                                            <Button Content="🐪 camelCase" Command="{Binding ActionCommand}" CommandParameter="StructuredCamelCase" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="📐 PascalCase" Command="{Binding ActionCommand}" CommandParameter="StructuredPascalCase" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="🐍 snake_case" Command="{Binding ActionCommand}" CommandParameter="StructuredSnakeCase" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="🍢 kebab-case" Command="{Binding ActionCommand}" CommandParameter="StructuredKebabCase" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="🔠 UPPER_CASE" Command="{Binding ActionCommand}" CommandParameter="StructuredConstantCase" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                        </UniformGrid>
                                    </Expander>

                                    <!-- Key & Field Filtering -->
                                    <Expander Header="Key &amp; Field Filtering" controls:SectionState.Key="Structured_KeyFiltering" Style="{StaticResource SectionExpanderStyle}">
                                        <StackPanel>
                                            <ui:TextBox Text="{Binding StructuredFilterKeyList, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Keys (e.g. id, name, email)..." ClearButtonEnabled="False" FontSize="11" Margin="0,0,0,3"/>
                                            <UniformGrid Columns="2">
                                                <Button Content="🎯 Pick Keys" Command="{Binding ActionCommand}" CommandParameter="PickStructuredKeys" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                                <Button Content="🚫 Omit Keys" Command="{Binding ActionCommand}" CommandParameter="OmitStructuredKeys" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            </UniformGrid>
                                            <Button Content="🧹 Strip Nulls &amp; Empty" Command="{Binding ActionCommand}" CommandParameter="RemoveNullsAndEmpty" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Expander>

                                    <!-- Query & Value Extraction -->
                                    <Expander Header="Query &amp; Value Extraction" controls:SectionState.Key="Structured_QueryExtraction" Style="{StaticResource SectionExpanderStyle}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ui:TextBox Grid.Column="0" Text="{Binding StructuredQueryPath, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="XPath / Path (e.g. //item, $.users)..." ClearButtonEnabled="False" FontSize="11"/>
                                                <Button Grid.Column="1" Content="🔍 Query" Command="{Binding ActionCommand}" CommandParameter="QueryStructuredPath" Style="{StaticResource ToolButtonStyle}" Padding="8,3" Margin="3,0,0,0" HorizontalContentAlignment="Center"/>
                                            </Grid>
                                            <UniformGrid Columns="2">
                                                <Button Content="🧭 XPath Query" Command="{Binding ActionCommand}" CommandParameter="QueryXPath" Style="{StaticResource PrimaryToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                                <Button Content="🏷️ XPath Values" Command="{Binding ActionCommand}" CommandParameter="ExtractXPathValues" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                                <Button Content="🗺️ All Paths" Command="{Binding ActionCommand}" CommandParameter="ExtractStructuredPaths" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                                <Button Content="🔑 All Keys" Command="{Binding ActionCommand}" CommandParameter="ExtractStructuredKeys" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                                <Button Content="📋 All Values" Command="{Binding ActionCommand}" CommandParameter="ExtractStructuredValues" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                                <Button Content="🏷️ Attributes" Command="{Binding ActionCommand}" CommandParameter="ExtractXPathAttributes" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Expander>

                                    <!-- Deep Sort & Flatten -->
                                    <Expander Header="Deep Sort &amp; Flatten" controls:SectionState.Key="Structured_SortFlatten" Style="{StaticResource SectionExpanderStyle}">
                                        <UniformGrid Columns="2">
                                            <Button Content="🔤 Sort A-Z" Command="{Binding ActionCommand}" CommandParameter="SortStructuredKeysAsc" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="🔤 Sort Z-A" Command="{Binding ActionCommand}" CommandParameter="SortStructuredKeysDesc" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="🌿 Flatten Paths" Command="{Binding ActionCommand}" CommandParameter="FlattenStructured" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="📦 Flat JSON" Command="{Binding ActionCommand}" CommandParameter="FlattenToFlatJson" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="🌳 Unflatten JSON" Command="{Binding ActionCommand}" CommandParameter="UnflattenToJson" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="📜 Unflatten YAML" Command="{Binding ActionCommand}" CommandParameter="UnflattenToYaml" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                        </UniformGrid>
                                    </Expander>

                                    <!-- Formatting & Minification -->
                                    <Expander Header="Formatting &amp; Minify" controls:SectionState.Key="Structured_FormatMinify" Style="{StaticResource SectionExpanderStyle}">
                                        <UniformGrid Columns="2">
                                            <Button Content="✨ Beautify JSON" Command="{Binding ActionCommand}" CommandParameter="BeautifyJson" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="📦 Minify JSON" Command="{Binding ActionCommand}" CommandParameter="MinifyJson" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="✨ Beautify YAML" Command="{Binding ActionCommand}" CommandParameter="BeautifyYaml" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="📑 Minify XML" Command="{Binding ActionCommand}" CommandParameter="MinifyXml" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="✨ Beautify XML" Command="{Binding ActionCommand}" CommandParameter="BeautifyXml" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                        </UniformGrid>
                                    </Expander>

                                    <!-- Code & Schema Generation -->
                                    <Expander Header="Code &amp; Schema Generation" controls:SectionState.Key="Structured_CodeSchemaGen" Style="{StaticResource SectionExpanderStyle}">
                                        <StackPanel>
                                            <UniformGrid Columns="2">
                                                <Button Content="📜 TypeScript" Command="{Binding ActionCommand}" CommandParameter="ToTypeScriptInterfaces" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                                <Button Content="💻 C# POCO" Command="{Binding ActionCommand}" CommandParameter="ToCSharpClasses" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            </UniformGrid>
                                            <Button Content="📋 JSON Schema" Command="{Binding ActionCommand}" CommandParameter="ToJsonSchema" Style="{StaticResource PrimaryToolButtonStyle}" HorizontalContentAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- TAB 4: CODE & FORMATS -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="💻 Code" FontSize="11" VerticalAlignment="Center"/>
                                    <Ellipse Width="6" Height="6" Fill="#4EC9B0" Margin="5,0,0,0" VerticalAlignment="Center"
