                                        </UniformGrid>
                                    </Expander>

                                    <Expander Header="Code Array Literals" controls:SectionState.Key="Code_CodeArrayLiterals" Style="{StaticResource SectionExpanderStyle}">
                                        <UniformGrid Columns="2">
                                            <Button Content="💻 C# Array" Command="{Binding ActionCommand}" CommandParameter="ToCSharpArray" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="💻 C# List" Command="{Binding ActionCommand}" CommandParameter="ToCSharpList" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="📜 TypeScript" Command="{Binding ActionCommand}" CommandParameter="ToTypeScriptArray" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="🐍 Python List" Command="{Binding ActionCommand}" CommandParameter="ToPythonList" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="📦 JSON Array" Command="{Binding ActionCommand}" CommandParameter="ToJsonArray" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="📜 YAML List" Command="{Binding ActionCommand}" CommandParameter="ToYamlArray" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                        </UniformGrid>
                                    </Expander>

                                    <Expander Header="Web &amp; Parameters" controls:SectionState.Key="Code_WebParameters" Style="{StaticResource SectionExpanderStyle}">
                                        <UniformGrid Columns="2">
                                            <Button Content="🌐 Query → KV" Command="{Binding ActionCommand}" CommandParameter="QueryStringToKv" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="🔗 KV → Query" Command="{Binding ActionCommand}" CommandParameter="KvToQueryString" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="📦 KV → JSON" Command="{Binding ActionCommand}" CommandParameter="KvToJson" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="📜 KV → YAML" Command="{Binding ActionCommand}" CommandParameter="KvToYaml" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                        </UniformGrid>
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- TAB 5: CASE & ENCODING -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🔤 Case / Enc" FontSize="11" VerticalAlignment="Center"/>
                                    <Ellipse Width="6" Height="6" Fill="#4EC9B0" Margin="5,0,0,0" VerticalAlignment="Center"
                                             Visibility="{Binding IsCaseEncTabHighlighted, Converter={StaticResource BooleanToVisibilityConverter}}"
                                             ToolTip="Recommended for current input format"/>
                                </StackPanel>
                            </TabItem.Header>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                                <StackPanel>
                                    <Expander Header="Case Conversions" controls:SectionState.Key="CaseEnc_CaseConversions" Style="{StaticResource SectionExpanderStyle}">
                                        <UniformGrid Columns="2">
                                            <Button Content="🐪 camelCase" Command="{Binding ActionCommand}" CommandParameter="CamelCase" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="📐 PascalCase" Command="{Binding ActionCommand}" CommandParameter="PascalCase" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="🐍 snake_case" Command="{Binding ActionCommand}" CommandParameter="SnakeCase" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="🍢 kebab-case" Command="{Binding ActionCommand}" CommandParameter="KebabCase" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="🔠 CONSTANT_CASE" Command="{Binding ActionCommand}" CommandParameter="ConstantCase" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="📰 Title Case" Command="{Binding ActionCommand}" CommandParameter="TitleCase" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="🔠 UPPERCASE" Command="{Binding ActionCommand}" CommandParameter="UpperCase" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="🔡 lowercase" Command="{Binding ActionCommand}" CommandParameter="LowerCase" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                        </UniformGrid>
                                    </Expander>

                                    <Expander Header="Encodings &amp; Escapes" controls:SectionState.Key="CaseEnc_EncodingsEscapes" Style="{StaticResource SectionExpanderStyle}">
                                        <UniformGrid Columns="2">
                                            <Button Content="🌐 URL Encode" Command="{Binding ActionCommand}" CommandParameter="UrlEncode" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="🔓 URL Decode" Command="{Binding ActionCommand}" CommandParameter="UrlDecode" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="🔐 Base64 Encode" Command="{Binding ActionCommand}" CommandParameter="Base64Encode" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="🔓 Base64 Decode" Command="{Binding ActionCommand}" CommandParameter="Base64Decode" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="🏷️ HTML Encode" Command="{Binding ActionCommand}" CommandParameter="HtmlEncode" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="🔓 HTML Decode" Command="{Binding ActionCommand}" CommandParameter="HtmlDecode" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="💻 C# Escape" Command="{Binding ActionCommand}" CommandParameter="EscapeCSharp" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="💻 C# Unescape" Command="{Binding ActionCommand}" CommandParameter="UnescapeCSharp" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="✨ JSON Beautify" Command="{Binding ActionCommand}" CommandParameter="FormatJson" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="✨ YAML Beautify" Command="{Binding ActionCommand}" CommandParameter="FormatYaml" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="✨ XML Beautify" Command="{Binding ActionCommand}" CommandParameter="FormatXml" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="✨ Auto Beautify" Command="{Binding ActionCommand}" CommandParameter="Beautify" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="🔄 JSON ➔ YAML" Command="{Binding ActionCommand}" CommandParameter="JsonToYaml" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="🔄 YAML ➔ JSON" Command="{Binding ActionCommand}" CommandParameter="YamlToJson" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                            <Button Content="🔑 JWT Decode" Command="{Binding ActionCommand}" CommandParameter="JwtDecode" Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Center"/>
                                        </UniformGrid>
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- TAB 6: RECIPES & PIPELINES -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⚡ Recipes" FontSize="11" VerticalAlignment="Center"/>
                                    <Ellipse Width="6" Height="6" Fill="#4EC9B0" Margin="5,0,0,0" VerticalAlignment="Center"
                                             Visibility="{Binding IsRecipesTabHighlighted, Converter={StaticResource BooleanToVisibilityConverter}}"
                                             ToolTip="Recommended recipe available"/>
                                </StackPanel>
                            </TabItem.Header>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
                                <StackPanel>
                                    <!-- Visual Pipeline Builder Expander -->
                                    <Expander Header="🔗 Visual Pipeline Builder" IsExpanded="True" controls:SectionState.Key="Recipes_PipelineBuilder" Style="{StaticResource SectionExpanderStyle}">
                                        <StackPanel>
                                            <!-- Pipeline Action Toolbar -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding PipelineStatusText}" Foreground="{DynamicResource AccentBlueBadgeBrush}" FontSize="11" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <Button Grid.Column="1" Content="🗑️ Clear" Command="{Binding ClearPipelineCommand}" Style="{DynamicResource SecondaryToolButtonStyle}" Padding="6,2" FontSize="10" ToolTip="Clear all steps in the current pipeline"/>
                                            </Grid>

                                            <!-- Step Builder List -->
                                            <Border Background="{DynamicResource SurfaceDarkBackgroundBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,0,0,6" MinHeight="40">
                                                <StackPanel>
                                                    <TextBlock Text="Pipeline is empty. Add steps below to build a transformation chain."
                                                               Foreground="{DynamicResource MutedTextBrush}" FontSize="11" FontStyle="Italic" Margin="6,8"
                                                               Visibility="{Binding HasPipelineSteps, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

                                                    <ItemsControl ItemsSource="{Binding CurrentPipelineSteps}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Margin="0,2" Padding="6,4">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <!-- Step Checkbox -->
                                                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,4,0" ToolTip="Enable / disable this step"/>
                                                                        <!-- Icon -->
                                                                        <TextBlock Grid.Column="1" Text="{Binding Icon}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                        <!-- Title & Description -->
                                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                                            <TextBlock Text="{Binding Category}" FontSize="9" Foreground="{DynamicResource MutedTextBrush}"/>
                                                                        </StackPanel>
                                                                        <!-- Step Actions: Up / Down / Remove -->
                                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <Button Content="▲" Command="{Binding DataContext.MoveStepUpCommand, RelativeSource={RelativeSource AncestorType=TabControl}}" CommandParameter="{Binding}"
                                                                                    Style="{DynamicResource SecondaryToolButtonStyle}" Width="20" Height="20" Padding="0" Margin="1,0" FontSize="8" ToolTip="Move step up"/>
                                                                            <Button Content="▼" Command="{Binding DataContext.MoveStepDownCommand, RelativeSource={RelativeSource AncestorType=TabControl}}" CommandParameter="{Binding}"
                                                                                    Style="{DynamicResource SecondaryToolButtonStyle}" Width="20" Height="20" Padding="0" Margin="1,0" FontSize="8" ToolTip="Move step down"/>
                                                                            <Button Content="✕" Command="{Binding DataContext.RemoveStepFromPipelineCommand, RelativeSource={RelativeSource AncestorType=TabControl}}" CommandParameter="{Binding}"
                                                                                    Style="{DynamicResource SecondaryToolButtonStyle}" Width="20" Height="20" Padding="0" Margin="1,0" FontSize="8" Foreground="#FF6B6B" ToolTip="Remove step"/>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>

                                            <!-- Add Step Selector -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox ItemsSource="{Binding CatalogItems}" SelectedItem="{Binding SelectedCatalogItemToAdd, Mode=TwoWay}" DisplayMemberPath="Title" FontSize="11" Margin="0,0,4,0"/>
                                                <Button Grid.Column="1" Content="➕ Add Step" Command="{Binding AddStepToPipelineCommand}" Style="{StaticResource PrimaryToolButtonStyle}" Padding="8,4" FontSize="11"/>
                                            </Grid>

                                            <!-- Execute Pipeline Button -->
                                            <Button Content="▶ Run Current Pipeline (F5)" Command="{Binding ExecuteCurrentPipelineCommand}" Style="{StaticResource PrimaryToolButtonStyle}" Margin="0,0,0,4" FontWeight="Bold"/>

                                            <!-- Save Custom Preset Expander -->
                                            <Expander Header="💾 Save Pipeline as New Preset" Style="{StaticResource SectionExpanderStyle}" Margin="0,4,0,0">
                                                <StackPanel Margin="0,4,0,0">
                                                    <TextBlock Text="Recipe Name:" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,0,0,2"/>
                                                    <ui:TextBox Text="{Binding NewRecipeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Margin="0,0,0,4"/>
                                                    <TextBlock Text="Description:" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,0,0,2"/>
                                                    <ui:TextBox Text="{Binding NewRecipeDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Margin="0,0,0,4"/>
                                                    <TextBlock Text="Hotkey (optional, e.g. Ctrl+Alt+8):" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,0,0,2"/>
                                                    <ui:TextBox Text="{Binding NewRecipeHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Margin="0,0,0,6"/>
                                                    <Button Content="💾 Save Recipe Preset" Command="{Binding SavePipelineAsRecipeCommand}" Style="{StaticResource PrimaryToolButtonStyle}"/>
                                                </StackPanel>
                                            </Expander>
                                        </StackPanel>
                                    </Expander>

                                    <!-- Saved Recipes & Presets Library Expander -->
                                    <Expander Header="📚 Saved Recipe Presets" IsExpanded="True" controls:SectionState.Key="Recipes_PresetLibrary" Style="{StaticResource SectionExpanderStyle}">
                                        <StackPanel>
                                            <!-- Import / Export Bar -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Content="📥 Import JSON" Command="{Binding ImportRecipesCommand}" Style="{StaticResource ToolButtonStyle}" Margin="0,0,2,0" FontSize="10" ToolTip="Import recipe(s) from clipboard JSON"/>
                                                <Button Grid.Column="1" Content="📤 Export All JSON" Command="{Binding ExportAllRecipesCommand}" Style="{StaticResource ToolButtonStyle}" Margin="2,0,0,0" FontSize="10" ToolTip="Export all recipes to clipboard JSON"/>
                                            </Grid>

                                            <!-- Preset Cards List -->
                                            <ItemsControl ItemsSource="{Binding SavedRecipes}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource SurfaceDarkBackgroundBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,6" Padding="8,6">
                                                            <StackPanel>
                                                                <!-- Card Header -->
                                                                <Grid Margin="0,0,0,3">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                        <Border Background="{DynamicResource BadgeBackgroundBrush}" CornerRadius="3" Padding="4,1" Margin="0,0,3,0"
                                                                                Visibility="{Binding Hotkey, Converter={StaticResource StringToVisibilityConverter}}">
                                                                            <TextBlock Text="{Binding Hotkey}" FontSize="9" Foreground="{DynamicResource AccentBlueBadgeBrush}" FontWeight="SemiBold"/>
                                                                        </Border>
                                                                        <Border Background="{DynamicResource BadgeBackgroundBrush}" CornerRadius="3" Padding="4,1">
                                                                            <TextBlock Text="{Binding Category}" FontSize="9" Foreground="{DynamicResource MutedTextBrush}"/>
                                                                        </Border>
                                                                    </StackPanel>
                                                                </Grid>

                                                                <!-- Steps Summary -->
                                                                <TextBlock Text="{Binding StepSummary}" FontSize="10" Foreground="{DynamicResource AccentBlueBadgeBrush}" TextWrapping="Wrap" Margin="0,0,0,3"/>

                                                                <!-- Description -->
                                                                <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>

                                                                <!-- Card Actions -->
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Button Grid.Column="0" Content="▶ Run" Command="{Binding DataContext.ExecuteRecipeCommand, RelativeSource={RelativeSource AncestorType=TabControl}}" CommandParameter="{Binding}"
                                                                            Style="{StaticResource PrimaryToolButtonStyle}" Padding="6,3" FontSize="10" FontWeight="SemiBold"/>
                                                                    <Button Grid.Column="1" Content="✏️ Edit" Command="{Binding DataContext.LoadRecipeToPipelineCommand, RelativeSource={RelativeSource AncestorType=TabControl}}" CommandParameter="{Binding}"
                                                                            Style="{DynamicResource SecondaryToolButtonStyle}" Margin="3,0,0,0" Padding="5,3" FontSize="10" ToolTip="Load steps into visual pipeline editor"/>
                                                                    <Button Grid.Column="2" Content="📑 Copy" Command="{Binding DataContext.DuplicateRecipeCommand, RelativeSource={RelativeSource AncestorType=TabControl}}" CommandParameter="{Binding}"
                                                                            Style="{DynamicResource SecondaryToolButtonStyle}" Margin="3,0,0,0" Padding="5,3" FontSize="10" ToolTip="Duplicate recipe as new custom preset"/>
                                                                    <Button Grid.Column="3" Content="📋 JSON" Command="{Binding DataContext.ExportRecipeCommand, RelativeSource={RelativeSource AncestorType=TabControl}}" CommandParameter="{Binding}"
                                                                            Style="{DynamicResource SecondaryToolButtonStyle}" Margin="3,0,0,0" Padding="5,3" FontSize="10" ToolTip="Export recipe JSON to clipboard"/>
                                                                    <Button Grid.Column="4" Content="🗑️" Command="{Binding DataContext.DeleteRecipeCommand, RelativeSource={RelativeSource AncestorType=TabControl}}" CommandParameter="{Binding}"
                                                                            Style="{DynamicResource SecondaryToolButtonStyle}" Margin="3,0,0,0" Padding="5,3" FontSize="10" Foreground="#FF6B6B" ToolTip="Delete custom recipe"
                                                                            Visibility="{Binding IsBuiltIn, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="3" Background="{DynamicResource SurfaceDarkBackgroundBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="12,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:ToggleSwitch Content="⚡ Real-time Transform" IsChecked="{Binding IsRealTimeTransform, Mode=TwoWay}" FontSize="11" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <ui:ToggleSwitch Content="📋 Watch Clipboard" IsChecked="{Binding WatchClipboard, Mode=TwoWay}" ToolTip="Automatically watch for new clipboard items and add them to the input" FontSize="11" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <ui:ToggleSwitch Content="🔁 Auto Output → Input" IsChecked="{Binding AutoSendOutputToInput, Mode=TwoWay}" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- COMMAND PALETTE / ACTION FUZZY SEARCH MODAL OVERLAY -->
        <Grid Grid.Row="0" Grid.RowSpan="4" Panel.ZIndex="2000"
              Visibility="{Binding IsCommandPaletteOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <!-- Semi-transparent backdrop -->
            <Border Background="#B0000000" MouseDown="CommandPaletteBackdrop_MouseDown"/>

            <!-- Floating Command Palette Dialog Card -->
            <Border Width="640" MaxHeight="500" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,45,0,0"
                    Background="{DynamicResource SurfaceBackgroundBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="10" Direction="270" Color="#000000" Opacity="0.85"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Search Box Header -->
                        <RowDefinition Height="Auto"/>
                        <!-- Results List -->
                        <RowDefinition Height="*"/>
                        <!-- Footer Hints -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Search Box Header -->
                    <Border Grid.Row="0" Padding="12,10" Background="{DynamicResource SurfaceDarkBackgroundBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Search24" FontSize="18" Foreground="{DynamicResource AccentBlueBadgeBrush}" Margin="2,0,10,0" VerticalAlignment="Center"/>
                            <ui:TextBox x:Name="ActionSearchTextBox" Grid.Column="1"
                                        Text="{Binding ActionSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Type an action, format, conversion, or shortcut... (e.g. 'sql in', 'json', 'camel', 'yaml', 'sort', 'ts')"
                                        FontSize="13"
                                        ClearButtonEnabled="True"
                                        VerticalAlignment="Center"
                                        PreviewKeyDown="ActionSearchTextBox_PreviewKeyDown"/>
                        </Grid>
                    </Border>

                    <!-- Action Results ListBox -->
                    <ListBox x:Name="ActionSearchResultsListBox" Grid.Row="1"
                             ItemsSource="{Binding FilteredActions}"
                             SelectedItem="{Binding SelectedAction, Mode=TwoWay}"
                             MaxHeight="360"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="6"
                             MouseDoubleClick="ActionSearchResultsListBox_MouseDoubleClick"
                             KeyDown="ActionSearchResultsListBox_KeyDown">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#25FFFFFF"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#30007ACC"/>
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#60007ACC"/>
                                                    <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Icon / Emoji -->
                                    <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    <!-- Title & Description -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,10,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- Category Badge -->
                                    <Border Grid.Column="2" Background="#20FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="3" Padding="6,2" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </Border>

                                    <!-- Shortcut Badge (if any) -->
                                    <Border Grid.Column="3" Background="#33000000" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="3" Padding="4,1" VerticalAlignment="Center"
                                            Visibility="{Binding Shortcut, Converter={StaticResource StringToVisibilityConverter}}">
                                        <TextBlock Text="{Binding Shortcut}" FontSize="9" FontFamily="Consolas" Foreground="#AAAAAA"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Footer Hints Bar -->
                    <Border Grid.Row="2" Background="{DynamicResource SurfaceDarkBackgroundBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,8,8" Padding="12,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="↑↓ to navigate  •  " FontSize="10" Foreground="{DynamicResource MutedTextBrush}"/>
                                <TextBlock Text="Enter to select  •  " FontSize="10" Foreground="{DynamicResource MutedTextBrush}"/>
                                <TextBlock Text="Esc to close" FontSize="10" Foreground="{DynamicResource MutedTextBrush}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding ActionResultsCountText}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
