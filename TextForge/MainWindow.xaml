<Window x:Class="TextForge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TextForge"
        xmlns:vm="clr-namespace:TextForge.ViewModels"
        xmlns:core="clr-namespace:TextForge.Core.Transformers;assembly=TextForge.Core"
        xmlns:conv="clr-namespace:TextForge.Converters"
        xmlns:controls="clr-namespace:TextForge.Controls"
        mc:Ignorable="d"
        Title="TextForge - General Purpose Text Analyzer &amp; Transformer"
        Height="780" Width="1240"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource CatalystWindowStyle}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.InputBindings>
        <KeyBinding Key="I" Modifiers="Control+Shift" Command="{Binding SendToInputCommand}"/>
        <KeyBinding Key="I" Modifiers="Alt" Command="{Binding SendToInputCommand}"/>
        <KeyBinding Key="F4" Command="{Binding SendToInputCommand}"/>
        <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding HistoryBackCommand}"/>
        <KeyBinding Key="Right" Modifiers="Alt" Command="{Binding HistoryForwardCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <conv:BooleanToTextWrappingConverter x:Key="BoolToWrapConv"/>
        <!-- Custom Mono Font for Developer Text Boxes -->
        <FontFamily x:Key="EditorFontFamily">Cascadia Code, Consolas, Courier New, monospace</FontFamily>

        <!-- Send to Input Green Accent Button Style -->
        <Style x:Key="SendToInputButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E7E34"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#28A745"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#28A745"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#34D058"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#155724"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#1E7E34"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#2D3748"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#4A5568"/>
                                <Setter Property="Foreground" Value="#718096"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section Header Style -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#007ACC"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,6,0,3"/>
        </Style>

        <!-- Section Expander Style -->
        <Style x:Key="SectionExpanderStyle" TargetType="Expander" BasedOn="{StaticResource CatalystExpanderStyle}">
            <Setter Property="IsExpanded" Value="False"/>
            <Setter Property="Foreground" Value="#007ACC"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,2,0,4"/>
            <Setter Property="Padding" Value="0,3,0,1"/>
        </Style>

        <!-- Tool Button Style -->
        <Style x:Key="ToolButtonStyle" TargetType="Button" BasedOn="{StaticResource CatalystButtonStyle}">
            <Setter Property="Margin" Value="1,1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <!-- Primary Action Button Style -->
        <Style x:Key="PrimaryToolButtonStyle" TargetType="Button" BasedOn="{StaticResource CatalystButtonStyle}">
            <Setter Property="Background" Value="#005A9E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="1,1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <!-- TabControl Dark Style -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="BorderBrush" Value="#3F3F3F"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="#3F3F3F" BorderThickness="1,1,1,0" Margin="0,0,2,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E1E1E"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#007ACC"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1,2,1,0"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2D2D30"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar TabItem Style with Dynamic Highlighting -->
        <Style x:Key="SidebarTabItemStyle" TargetType="TabItem">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#999999"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Margin="0,0,1,0">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="#3F3F3F"
                                    BorderThickness="1,1,1,0"
                                    Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ContentPresenter x:Name="contentPresenter"
                                                      ContentSource="Header"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                    <Ellipse x:Name="highlightDot"
                                             Width="5" Height="5"
                                             Fill="#4EC9B0"
                                             Margin="4,0,0,0"
                                             VerticalAlignment="Center"
                                             Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="accentBar"
                                    Height="2"
                                    VerticalAlignment="Top"
                                    Background="Transparent"
                                    HorizontalAlignment="Stretch"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- Highlighted (Suggested for current data) -->
                            <Trigger Property="Tag" Value="True">
                                <Setter TargetName="highlightDot" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="#DCDCDC"/>
                                <Setter TargetName="border" Property="Background" Value="#1C2E3D"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#0E5A8A"/>
                                <Setter TargetName="accentBar" Property="Background" Value="#4EC9B0"/>
                                <Setter Property="ToolTip" Value="Recommended for current input format"/>
                            </Trigger>
                            <!-- Mouse Over -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2D2D30"/>
                            </Trigger>
                            <!-- Selected Tab -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E1E1E"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#007ACC"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1,1,1,0"/>
                                <Setter TargetName="accentBar" Property="Background" Value="#007ACC"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <!-- Selected AND Highlighted -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="Tag" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="#1E1E1E"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#007ACC"/>
                                <Setter TargetName="accentBar" Property="Background" Value="#4EC9B0"/>
                                <Setter TargetName="highlightDot" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="highlightDot" Property="Fill" Value="#4EC9B0"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark DataGrid Style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#F0F0F0"/>
            <Setter Property="BorderBrush" Value="#3F3F3F"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#333333"/>
            <Setter Property="VerticalGridLinesBrush" Value="#333333"/>
            <Setter Property="RowBackground" Value="#1E1E1E"/>
            <Setter Property="AlternatingRowBackground" Value="#252526"/>
            <Setter Property="ColumnHeaderHeight" Value="28"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#3F3F3F"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                            <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridRow">
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <!-- Top Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
            <!-- Bottom Status Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Toolbar -->
        <Border Grid.Row="0" Background="#252526" BorderBrush="#3F3F3F" BorderThickness="0,0,0,1" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App Title & Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
                    <Border Background="#007ACC" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                        <TextBlock Text="TF" FontWeight="Bold" Foreground="White" FontSize="14"/>
                    </Border>
                    <TextBlock Text="TextForge" FontWeight="Bold" FontSize="16" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Detected Format Badge -->
                <Border Grid.Column="1" Background="#2D2D30" BorderBrush="#007ACC" BorderThickness="1" CornerRadius="3" Padding="8,4" VerticalAlignment="Center" Margin="0,0,15,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Detected: " Foreground="#888888" FontSize="11"/>
                        <TextBlock Text="{Binding DetectedFormatBadge}" Foreground="#4EC9B0" FontWeight="SemiBold" FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- Quick Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="◀ Back" Command="{Binding HistoryBackCommand}" ToolTip="Restore previous input snapshot (Alt+Left)" Style="{StaticResource CatalystButtonStyle}" Margin="0,0,4,0"/>
                    <Button Content="Forward ▶" Command="{Binding HistoryForwardCommand}" ToolTip="Restore next input snapshot (Alt+Right)" Style="{StaticResource CatalystButtonStyle}" Margin="0,0,8,0"/>
                    <Button Content="📸 Snapshot" Command="{Binding CreateSnapshotCommand}" ToolTip="Bookmark current input in timeline" Style="{StaticResource CatalystButtonStyle}" Margin="0,0,8,0"/>
                    <Button Content="📋 Paste" Command="{Binding PasteInputCommand}" Style="{StaticResource PrimaryToolButtonStyle}" Margin="0,0,6,0"/>
                    <Button Content="💾 Copy Output" Command="{Binding CopyOutputCommand}" Style="{StaticResource CatalystButtonStyle}" Margin="0,0,6,0"/>
                    <Button Content="🗑 Clear" Command="{Binding ClearInputCommand}" Style="{StaticResource CatalystButtonStyle}" Margin="0,0,10,0"/>

                    <!-- Sample Data Dropdown -->
                    <Menu Background="Transparent" VerticalAlignment="Center" Margin="0,0,10,0">
                        <MenuItem Header="💡 Samples" Foreground="#CCCCCC" Background="#2D2D30" BorderBrush="#3F3F3F" BorderThickness="1" Padding="8,5">
                            <MenuItem Header="HTML Table (Confluence / Web)" Command="{Binding LoadSampleCommand}" CommandParameter="html" Foreground="#4EC9B0" Background="#2D2D30"/>
                            <MenuItem Header="Numbers List (SQL IN)" Command="{Binding LoadSampleCommand}" CommandParameter="numbers" Foreground="#F0F0F0" Background="#2D2D30"/>
                            <MenuItem Header="CSV Table Data" Command="{Binding LoadSampleCommand}" CommandParameter="csv" Foreground="#F0F0F0" Background="#2D2D30"/>
                            <MenuItem Header="TSV Table Data (Excel)" Command="{Binding LoadSampleCommand}" CommandParameter="tsv" Foreground="#F0F0F0" Background="#2D2D30"/>
                            <MenuItem Header="Markdown Table" Command="{Binding LoadSampleCommand}" CommandParameter="markdown" Foreground="#F0F0F0" Background="#2D2D30"/>
                            <MenuItem Header="JSON Array of Objects" Command="{Binding LoadSampleCommand}" CommandParameter="json" Foreground="#F0F0F0" Background="#2D2D30"/>
                            <MenuItem Header="Delimited Single Line" Command="{Binding LoadSampleCommand}" CommandParameter="delimited" Foreground="#F0F0F0" Background="#2D2D30"/>
                            <MenuItem Header="URL Query String" Command="{Binding LoadSampleCommand}" CommandParameter="query" Foreground="#F0F0F0" Background="#2D2D30"/>
                        </MenuItem>
                    </Menu>
                </StackPanel>

                <!-- Settings Toggles -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="⚡ Real-time Transform" IsChecked="{Binding IsRealTimeTransform, Mode=TwoWay}" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <CheckBox Content="↩ Word Wrap" IsChecked="{Binding IsWordWrap, Mode=TwoWay}" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,5,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Workspace Area -->
        <Grid Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions>
                <!-- Input Pane (38%) -->
                <ColumnDefinition Width="3.8*" MinWidth="250"/>
                <ColumnDefinition Width="6"/>
                <!-- Output Pane (38%) -->
                <ColumnDefinition Width="3.8*" MinWidth="250"/>
                <ColumnDefinition Width="6"/>
                <!-- Tools / Transform Options Sidebar (24%) -->
                <ColumnDefinition Width="3.2*" MinWidth="260" MaxWidth="420"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: INPUT PANE -->
            <Border Grid.Column="0" Background="#252526" BorderBrush="#3F3F3F" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Pane Header -->
                    <Border Grid.Row="0" Background="#2D2D30" Padding="8,6" BorderBrush="#3F3F3F" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="INPUT" FontWeight="Bold" Foreground="#CCCCCC" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Syntax:" Foreground="#888888" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox ItemsSource="{Binding AvailableSyntaxLanguages}"
                                          SelectedItem="{Binding SelectedInputSyntax, UpdateSourceTrigger=PropertyChanged}"
                                          Width="95" Height="22" FontSize="10" Style="{StaticResource CatalystComboBoxStyle}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="◀" Command="{Binding HistoryBackCommand}" ToolTip="Previous Snapshot (Alt+Left)" Padding="5,2" FontSize="11" Style="{StaticResource CatalystButtonStyle}" Margin="0,0,2,0"/>
                                <Button Content="▶" Command="{Binding HistoryForwardCommand}" ToolTip="Next Snapshot (Alt+Right)" Padding="5,2" FontSize="11" Style="{StaticResource CatalystButtonStyle}" Margin="0,0,4,0"/>
                                <Button Content="📸" Command="{Binding CreateSnapshotCommand}" ToolTip="Save Current Snapshot" Padding="5,2" FontSize="11" Style="{StaticResource CatalystButtonStyle}" Margin="0,0,4,0"/>
                                <Button Content="Paste" Command="{Binding PasteInputCommand}" Padding="6,2" FontSize="11" Style="{StaticResource CatalystButtonStyle}" Margin="0,0,4,0"/>
                                <Button Content="Clear" Command="{Binding ClearInputCommand}" Padding="6,2" FontSize="11" Style="{StaticResource CatalystButtonStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Input Editor / History Tabs -->
                    <TabControl Grid.Row="1" BorderThickness="0" Background="#1E1E1E" Padding="0">
                        <!-- Tab 1: Editor -->
                        <TabItem Header="Editor">
                            <controls:BindableTextEditor x:Name="InputEditor"
                                                         BoundText="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                                         SyntaxLanguage="{Binding EffectiveInputSyntax}"
                                                         WordWrap="{Binding IsWordWrap}"
                                                         FontFamily="{StaticResource EditorFontFamily}"
                                                         FontSize="13"
                                                         Background="#1E1E1E"
                                                         Foreground="#D4D4D4"/>
                        </TabItem>

                        <!-- Tab 2: Timeline & History -->
                        <TabItem Header="{Binding HistoryTabHeader}">
                            <Grid Background="#1E1E1E">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1*" MinHeight="80"/>
                                    <RowDefinition Height="4"/>
                                    <RowDefinition Height="1*" MinHeight="80"/>
                                </Grid.RowDefinitions>

                                <!-- Top: Timeline snapshots list -->
                                <Grid Grid.Row="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- History Search & Actions Toolbar -->
                                    <Border Grid.Row="0" Background="#282828" Padding="6,4" BorderBrush="#3F3F3F" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding HistorySearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="#1E1E1E" Foreground="#E0E0E0" BorderBrush="#3F3F3F"
                                                     Padding="4,2" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Content="Clear All" Command="{Binding ClearHistoryCommand}" Padding="5,2" FontSize="10" Style="{StaticResource CatalystButtonStyle}" Margin="0,0,3,0"/>
                                                <Button Content="Export" Command="{Binding ExportHistoryCommand}" Padding="5,2" FontSize="10" Style="{StaticResource CatalystButtonStyle}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Timeline List -->
                                    <ListBox Grid.Row="1"
                                             ItemsSource="{Binding HistoryView}"
                                             SelectedItem="{Binding SelectedHistoryItem}"
                                             Background="#1E1E1E"
                                             BorderThickness="0"
                                             Padding="4"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0,0,0,4"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <ContentPresenter/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#252528" BorderBrush="#3F3F3F" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,2">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Header Line -->
                                                        <Grid Grid.Row="0" Margin="0,0,0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding TimeDisplay}" FontWeight="Bold" Foreground="#4EC9B0" FontSize="11" Margin="0,0,6,0"/>
                                                                <Border Background="#333337" CornerRadius="2" Padding="4,1" Margin="0,0,4,0">
                                                                    <TextBlock Text="{Binding Source}" Foreground="#CCCCCC" FontSize="10"/>
                                                                </Border>
                                                                <Border Background="#0E3A5A" CornerRadius="2" Padding="4,1">
                                                                    <TextBlock Text="{Binding FormatName}" Foreground="#4EC9B0" FontSize="10"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" Text="{Binding RelativeTime}" Foreground="#777777" FontSize="10"/>
                                                        </Grid>

                                                        <!-- Snippet Preview -->
                                                        <Border Grid.Row="1" Background="#1A1A1A" CornerRadius="2" Padding="5,3" Margin="0,0,0,4">
                                                            <TextBlock Text="{Binding Preview}" FontFamily="{StaticResource EditorFontFamily}" Foreground="#AAAAAA" FontSize="10" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxHeight="45"/>
                                                        </Border>

                                                        <!-- Footer Line & Actions -->
                                                        <Grid Grid.Row="2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding SizeDisplay}" Foreground="#888888" FontSize="10" VerticalAlignment="Center"/>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                <Button Content="↺ Restore" Command="{Binding DataContext.RestoreHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="5,1" FontSize="10" Style="{StaticResource PrimaryToolButtonStyle}" Margin="0,0,3,0"/>
                                                                <Button Content="➕ Append" Command="{Binding DataContext.AppendHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="4,1" FontSize="10" Style="{StaticResource CatalystButtonStyle}" Margin="0,0,3,0"/>
                                                                <Button Content="📋" Command="{Binding DataContext.CopyHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Copy to Clipboard" Padding="4,1" FontSize="10" Style="{StaticResource CatalystButtonStyle}" Margin="0,0,3,0"/>
                                                                <Button Content="🗑" Command="{Binding DataContext.DeleteHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Delete from History" Padding="4,1" FontSize="10" Style="{StaticResource CatalystButtonStyle}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>

                                <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="#282828"/>

                                <!-- Bottom: Full text preview of selected history snapshot -->
                                <Border Grid.Row="2" Background="#1E1E1E" Padding="6">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0" Background="#252528" Padding="6,4" CornerRadius="3" Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="Selected Snapshot Preview" FontWeight="Bold" Foreground="#CCCCCC" FontSize="11" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding SelectedHistoryItem.SizeDisplay}" Foreground="#888888" FontSize="10" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="↺ Restore to Input" Command="{Binding RestoreHistoryCommand}" CommandParameter="{Binding SelectedHistoryItem}" Style="{StaticResource PrimaryToolButtonStyle}" Padding="6,2" FontSize="10"/>
                                            </Grid>
                                        </Border>

                                        <TextBox Grid.Row="1"
                                                 Text="{Binding SelectedHistoryItem.FullText, Mode=OneWay}"
                                                 IsReadOnly="True"
                                                 FontFamily="{StaticResource EditorFontFamily}"
                                                 FontSize="12"
                                                 Background="#181818"
                                                 Foreground="#D4D4D4"
                                                 BorderBrush="#333333"
                                                 BorderThickness="1"
                                                 Padding="6"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Auto"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>

                    <!-- Input Footer / Stats -->
                    <Border Grid.Row="2" Background="#2D2D30" Padding="8,4" BorderBrush="#3F3F3F" BorderThickness="0,1,0,0">
                        <TextBlock Text="{Binding InputStats}" Foreground="#888888" FontSize="11"/>
                    </Border>
                </Grid>
            </Border>

            <!-- GridSplitter 1 -->
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="Transparent"/>

            <!-- CENTER: DATA VIEW & TEXT OUTPUT PANES (SPLIT VERTICALLY) -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <!-- Top: Table Grid View / Analysis & Stats -->
                    <RowDefinition Height="1*" MinHeight="100"/>
                    <RowDefinition Height="6"/>
                    <!-- Bottom: Dedicated Text Output Pane -->
                    <RowDefinition Height="1*" MinHeight="100"/>
                </Grid.RowDefinitions>

                <!-- TOP: TABLE GRID VIEW & ANALYSIS -->
                <Border Grid.Row="0" Background="#252526" BorderBrush="#3F3F3F" BorderThickness="1" CornerRadius="4">
                    <TabControl SelectedIndex="{Binding SelectedCenterTabIndex, Mode=TwoWay}" BorderThickness="0" Background="#1E1E1E" Padding="0">
                        <!-- Tab 1: Tabular Grid View -->
                        <TabItem Header="Table Grid View">
                            <Grid Background="#1E1E1E">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Grid Quick Actions Toolbar -->
                                <Border Grid.Row="0" Background="#282828" Padding="8,4" BorderBrush="#3F3F3F" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Analysis.FormatDescription, StringFormat='Grid: {0}'}" Foreground="#4EC9B0" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <CheckBox Content="First row has headers"
                                                      IsChecked="{Binding HasHeaders, Mode=TwoWay}"
                                                      Foreground="#D4D4D4"
                                                      FontSize="11"
                                                      VerticalAlignment="Center"
                                                      ToolTip="When checked, the first row of tabular data is used for column headers. When unchecked, all rows are treated as data."/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="Extract Selected" Command="{Binding ActionCommand}" CommandParameter="ExtractSelectedToLines" Padding="5,2" FontSize="10" Style="{StaticResource CatalystButtonStyle}" Margin="0,0,3,0"/>
                                            <Button Content="→ CSV" Command="{Binding ActionCommand}" CommandParameter="ExtractSelectedToCsv" Padding="5,2" FontSize="10" Style="{StaticResource CatalystButtonStyle}" Margin="0,0,3,0"/>
                                            <Button Content="→ JSON" Command="{Binding ActionCommand}" CommandParameter="ExtractSelectedToJson" Padding="5,2" FontSize="10" Style="{StaticResource CatalystButtonStyle}" Margin="0,0,3,0"/>
                                            <Button Content="→ SQL IN" Command="{Binding ActionCommand}" CommandParameter="ExtractSelectedToSqlIn" Padding="5,2" FontSize="10" Style="{StaticResource CatalystButtonStyle}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <DataGrid x:Name="PreviewDataGrid"
                                          Grid.Row="1"
                                          ItemsSource="{Binding PreviewDataTable}"
                                          AutoGenerateColumns="False"
                                          Sorting="PreviewDataGrid_Sorting"
                                          IsReadOnly="True"
                                          CanUserSortColumns="True"
                                          CanUserReorderColumns="True"
                                          EnableRowVirtualization="True"
                                          BorderThickness="0"/>
                            </Grid>
                        </TabItem>

                        <!-- Tab 2: Detailed Text Analysis -->
                        <TabItem Header="Analysis &amp; Stats">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="Document Statistics" FontWeight="Bold" FontSize="14" Foreground="#007ACC" Margin="0,0,0,10"/>
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="24"/>
                                            <RowDefinition Height="24"/>
                                            <RowDefinition Height="24"/>
                                            <RowDefinition Height="24"/>
                                            <RowDefinition Height="24"/>
                                            <RowDefinition Height="24"/>
                                            <RowDefinition Height="24"/>
                                            <RowDefinition Height="24"/>
                                            <RowDefinition Height="24"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Detected Structure:" Foreground="#AAAAAA"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Analysis.FormatDescription}" Foreground="#4EC9B0" FontWeight="Bold"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Total Characters:" Foreground="#AAAAAA"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Analysis.CharacterCount}" Foreground="#FFFFFF"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Chars (without spaces):" Foreground="#AAAAAA"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Analysis.CharacterCountNoSpaces}" Foreground="#FFFFFF"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Total Lines:" Foreground="#AAAAAA"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Analysis.LineCount}" Foreground="#FFFFFF"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Non-Empty Lines:" Foreground="#AAAAAA"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Analysis.NonEmptyLineCount}" Foreground="#FFFFFF"/>

                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Word Count:" Foreground="#AAAAAA"/>
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Analysis.WordCount}" Foreground="#FFFFFF"/>

                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Distinct Lines:" Foreground="#AAAAAA"/>
                                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Analysis.DistinctLineCount}" Foreground="#FFFFFF"/>

                                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Duplicate Lines:" Foreground="#AAAAAA"/>
                                        <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Analysis.DuplicateCount}" Foreground="#CE9178"/>

                                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Tabular Columns / Rows:" Foreground="#AAAAAA"/>
                                        <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Analysis.ColumnCount, StringFormat='{}{0} cols'}" Foreground="#FFFFFF"/>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Border>

                <!-- GridSplitter between Table/Analysis and Text Output -->
                <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent"/>

                <!-- BOTTOM: DEDICATED TEXT OUTPUT PANE -->
                <Border Grid.Row="2" Background="#252526" BorderBrush="#3F3F3F" BorderThickness="1" CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Output Header / Action Bar -->
                        <Border Grid.Row="0" Background="#2D2D30" Padding="8,6" BorderBrush="#3F3F3F" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="TEXT OUTPUT" FontWeight="Bold" Foreground="#CCCCCC" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Syntax:" Foreground="#888888" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <ComboBox ItemsSource="{Binding AvailableSyntaxLanguages}"
                                              SelectedItem="{Binding SelectedOutputSyntax, UpdateSourceTrigger=PropertyChanged}"
                                              Width="95" Height="22" FontSize="10" Style="{StaticResource CatalystComboBoxStyle}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="📋 Copy All" Command="{Binding CopyOutputCommand}" Padding="8,4" FontSize="11" Style="{StaticResource CatalystButtonStyle}" Margin="0,0,6,0" ToolTip="Copy all output to clipboard"/>
                                    <Button Content="⬆ Send to Input" Command="{Binding SendToInputCommand}" Style="{StaticResource SendToInputButtonStyle}" ToolTip="Send output text back into input pane (Shortcut: Ctrl+Shift+I / Alt+I / F4)"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Dedicated Output Editor -->
                        <controls:BindableTextEditor x:Name="OutputEditor"
                                                     Grid.Row="1"
                                                     BoundText="{Binding OutputText, UpdateSourceTrigger=PropertyChanged}"
                                                     SyntaxLanguage="{Binding EffectiveOutputSyntax}"
                                                     WordWrap="{Binding IsWordWrap}"
                                                     FontFamily="{StaticResource EditorFontFamily}"
                                                     FontSize="13"
                                                     Background="#1E1E1E"
                                                     Foreground="#D4D4D4"/>

                        <!-- Output Footer / Stats -->
                        <Border Grid.Row="2" Background="#2D2D30" Padding="8,4" BorderBrush="#3F3F3F" BorderThickness="0,1,0,0">
                            <TextBlock Text="{Binding OutputStats}" Foreground="#888888" FontSize="11"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- GridSplitter 2 -->
            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Center" Background="Transparent"/>

            <!-- RIGHT: TRANSFORMATION TOOLS SIDEBAR -->
            <Border Grid.Column="4" Background="#252526" BorderBrush="#3F3F3F" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#2D2D30" Padding="10,6" BorderBrush="#3F3F3F" BorderThickness="0,0,0,1">
                        <TextBlock Text="TRANSFORMATIONS" FontWeight="Bold" Foreground="#CCCCCC" FontSize="11"/>
                    </Border>

                    <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedSidebarTabIndex, Mode=TwoWay}" BorderThickness="0" Background="#252526" Padding="0">
                        <!-- TAB 1: QUICK PRESETS -->
                        <TabItem Header="⚡ Presets" Tag="{Binding IsPresetsTabHighlighted}" Style="{StaticResource SidebarTabItemStyle}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
                                <StackPanel>
                                    <Expander Header="Developer Favorites" controls:SectionState.Key="Presets_DeveloperFavorites" Style="{StaticResource SectionExpanderStyle}">
                                        <UniformGrid Columns="2">
                                            <Button Content="🔍 SQL IN (...)" Command="{Binding ActionCommand}" CommandParameter="SqlIn" Style="{StaticResource PrimaryToolButtonStyle}"/>
                                            <Button Content="📜 SQL Multi-line" Command="{Binding ActionCommand}" CommandParameter="SqlInMultiLine" Style="{StaticResource ToolButtonStyle}"/>
                                            <Button Content="🔗 Join (Comma)" Command="{Binding ActionCommand}" CommandParameter="JoinComma" Style="{StaticResource ToolButtonStyle}"/>
                                            <Button Content="💬 'Single Quote'" Command="{Binding ActionCommand}" CommandParameter="QuoteSingle" Style="{StaticResource ToolButtonStyle}"/>
                                            <Button Content="💬 &quot;Double Quote&quot;" Command="{Binding ActionCommand}" CommandParameter="QuoteDouble" Style="{StaticResource ToolButtonStyle}"/>
                                            <Button Content="💬 `Backtick Quote`" Command="{Binding ActionCommand}" CommandParameter="QuoteBackticks" Style="{StaticResource ToolButtonStyle}"/>
                                        </UniformGrid>
                                    </Expander>

                                    <Expander Header="Quick Arrays" controls:SectionState.Key="Presets_QuickArrays" Style="{StaticResource SectionExpanderStyle}">
                                        <StackPanel>
                                            <UniformGrid Columns="2">
                                                <Button Content="💻 C# Array" Command="{Binding ActionCommand}" CommandParameter="ToCSharpArray" Style="{StaticResource ToolButtonStyle}"/>
                                                <Button Content="📜 TypeScript Array" Command="{Binding ActionCommand}" CommandParameter="ToTypeScriptArray" Style="{StaticResource ToolButtonStyle}"/>
                                            </UniformGrid>
                                            <Button Content="📦 JSON Array [ ... ]" Command="{Binding ActionCommand}" CommandParameter="ToJsonArray" Style="{StaticResource ToolButtonStyle}"/>
                                        </StackPanel>
                                    </Expander>

                                    <Expander Header="Quick Sorting &amp; Cleaning" controls:SectionState.Key="Presets_QuickSortingAndCleaning" Style="{StaticResource SectionExpanderStyle}">
                                        <UniformGrid Columns="2">
                                            <Button Content="🔢 Natural Sort" Command="{Binding ActionCommand}" CommandParameter="SortNatural" Style="{StaticResource ToolButtonStyle}"/>
                                            <Button Content="🔤 A-Z Sort" Command="{Binding ActionCommand}" CommandParameter="SortAlphabetical" Style="{StaticResource ToolButtonStyle}"/>
                                            <Button Content="✂️ Deduplicate" Command="{Binding ActionCommand}" CommandParameter="Deduplicate" Style="{StaticResource ToolButtonStyle}"/>
                                            <Button Content="🧹 Trim Spaces" Command="{Binding ActionCommand}" CommandParameter="TrimLines" Style="{StaticResource ToolButtonStyle}"/>
                                        </UniformGrid>
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- TAB 2: LINES & LISTS -->
                        <TabItem Header="📄 Lines" Tag="{Binding IsLinesTabHighlighted}" Style="{StaticResource SidebarTabItemStyle}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
                                <StackPanel>
                                    <!-- Join Lines -->
                                    <Expander Header="Join Lines" controls:SectionState.Key="Lines_JoinLines" Style="{StaticResource SectionExpanderStyle}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Delimiter: " VerticalAlignment="Center" Foreground="#AAAAAA" Margin="0,0,5,0" FontSize="11"/>
                                                <TextBox Grid.Column="1" Text="{Binding JoinDelimiter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CatalystTextBoxStyle}"/>
                                            </Grid>
                                            <Button Content="🔗 Join Lines into Single Row" Command="{Binding ActionCommand}" CommandParameter="JoinLines" Style="{StaticResource PrimaryToolButtonStyle}"/>
                                        </StackPanel>
                                    </Expander>

                                    <!-- Quote Lines -->
                                    <Expander Header="Quote Lines" controls:SectionState.Key="Lines_QuoteLines" Style="{StaticResource SectionExpanderStyle}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Style: " VerticalAlignment="Center" Foreground="#AAAAAA" Margin="0,0,5,0" FontSize="11"/>
                                                <ComboBox Grid.Column="1" SelectedValue="{Binding QuoteStyle, Mode=TwoWay}" SelectedValuePath="Tag" Style="{StaticResource CatalystComboBoxStyle}">
                                                    <ComboBoxItem Content="'Single Quotes'" Tag="{x:Static core:QuoteStyle.SingleQuotes}"/>
                                                    <ComboBoxItem Content="&quot;Double Quotes&quot;" Tag="{x:Static core:QuoteStyle.DoubleQuotes}"/>
                                                    <ComboBoxItem Content="`Backticks`" Tag="{x:Static core:QuoteStyle.Backticks}"/>
                                                    <ComboBoxItem Content="[Square Brackets]" Tag="{x:Static core:QuoteStyle.SquareBrackets}"/>
                                                    <ComboBoxItem Content="(Parentheses)" Tag="{x:Static core:QuoteStyle.Parentheses}"/>
                                                    <ComboBoxItem Content="{}{Curly Braces}" Tag="{x:Static core:QuoteStyle.CurlyBraces}"/>
                                                </ComboBox>
                                            </Grid>
                                            <Button Content="💬 Quote All Lines" Command="{Binding ActionCommand}" CommandParameter="QuoteLines" Style="{StaticResource ToolButtonStyle}"/>
                                        </StackPanel>
                                    </Expander>

                                    <!-- Split Lines -->
                                    <Expander Header="Split Delimited Line" controls:SectionState.Key="Lines_SplitDelimitedLine" Style="{StaticResource SectionExpanderStyle}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Split By: " VerticalAlignment="Center" Foreground="#AAAAAA" Margin="0,0,5,0" FontSize="11"/>
                                                <TextBox Grid.Column="1" Text="{Binding SplitDelimiter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CatalystTextBoxStyle}"/>
                                            </Grid>
                                            <Button Content="✂️ Split into Multiple Lines" Command="{Binding ActionCommand}" CommandParameter="SplitLine" Style="{StaticResource ToolButtonStyle}"/>
                                        </StackPanel>
                                    </Expander>

                                    <!-- Prefix / Suffix -->
                                    <Expander Header="Prefix / Suffix" controls:SectionState.Key="Lines_PrefixSuffix" Style="{StaticResource SectionExpanderStyle}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="45"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Prefix: " VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="11"/>
                                                <TextBox Grid.Column="1" Text="{Binding LinePrefix, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CatalystTextBoxStyle}"/>
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Margin="45,0,0,4">
                                                <CheckBox Content="Skip 1st" IsChecked="{Binding LinePrefixSkipFirst, Mode=TwoWay}" Foreground="#AAAAAA" FontSize="10" Margin="0,0,8,0"/>
                                                <CheckBox Content="Skip last" IsChecked="{Binding LinePrefixSkipLast, Mode=TwoWay}" Foreground="#AAAAAA" FontSize="10"/>
                                            </StackPanel>
                                            <Grid Margin="0,0,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="45"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Suffix: " VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="11"/>
                                                <TextBox Grid.Column="1" Text="{Binding LineSuffix, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CatalystTextBoxStyle}"/>
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Margin="45,0,0,4">
                                                <CheckBox Content="Skip 1st" IsChecked="{Binding LineSuffixSkipFirst, Mode=TwoWay}" Foreground="#AAAAAA" FontSize="10" Margin="0,0,8,0"/>
                                                <CheckBox Content="Skip last" IsChecked="{Binding LineSuffixSkipLast, Mode=TwoWay}" Foreground="#AAAAAA" FontSize="10"/>
                                            </StackPanel>
                                            <Button Content="➕ Add Prefix / Suffix to Lines" Command="{Binding ActionCommand}" CommandParameter="PrefixSuffix" Style="{StaticResource ToolButtonStyle}"/>
                                        </StackPanel>
                                    </Expander>

                                    <!-- Find & Replace in Lines -->
                                    <Expander Header="Find &amp; Replace" controls:SectionState.Key="Lines_FindReplace" Style="{StaticResource SectionExpanderStyle}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="45"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Find: " VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="11"/>
                                                <TextBox Grid.Column="1" Text="{Binding LineFind, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CatalystTextBoxStyle}"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="45"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Replace: " VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="11"/>
                                                <TextBox Grid.Column="1" Text="{Binding LineReplace, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CatalystTextBoxStyle}"/>
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                                                <CheckBox Content="Match Case" IsChecked="{Binding LineReplaceCaseSensitive, Mode=TwoWay}" Foreground="#AAAAAA" FontSize="10" Margin="0,0,10,0"/>
                                                <CheckBox Content="Regex" IsChecked="{Binding LineReplaceIsRegex, Mode=TwoWay}" Foreground="#AAAAAA" FontSize="10"/>
                                            </StackPanel>
                                            <Button Content="🔄 Replace in Every Line" Command="{Binding ActionCommand}" CommandParameter="ReplaceInLines" Style="{StaticResource ToolButtonStyle}"/>
                                        </StackPanel>
                                    </Expander>

                                    <!-- Sort & Deduplicate -->
                                    <Expander Header="Sort &amp; Deduplicate" controls:SectionState.Key="Lines_SortDeduplicate" Style="{StaticResource SectionExpanderStyle}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Order: " VerticalAlignment="Center" Foreground="#AAAAAA" Margin="0,0,5,0" FontSize="11"/>
                                                <ComboBox Grid.Column="1" SelectedValue="{Binding SortOrder, Mode=TwoWay}" SelectedValuePath="Tag" Style="{StaticResource CatalystComboBoxStyle}">
                                                    <ComboBoxItem Content="Natural / Numeric (1, 2, 10)" Tag="{x:Static core:SortOrder.NaturalNumericAsc}"/>
                                                    <ComboBoxItem Content="Natural Numeric Desc" Tag="{x:Static core:SortOrder.NaturalNumericDesc}"/>
                                                    <ComboBoxItem Content="Alphabetical (A-Z)" Tag="{x:Static core:SortOrder.AlphabeticalAsc}"/>
                                                    <ComboBoxItem Content="Alphabetical (Z-A)" Tag="{x:Static core:SortOrder.AlphabeticalDesc}"/>
                                                    <ComboBoxItem Content="Shortest to Longest" Tag="{x:Static core:SortOrder.LengthAsc}"/>
                                                    <ComboBoxItem Content="Longest to Shortest" Tag="{x:Static core:SortOrder.LengthDesc}"/>
                                                    <ComboBoxItem Content="Reverse Lines" Tag="{x:Static core:SortOrder.Reverse}"/>
                                                </ComboBox>
                                            </Grid>
                                            <UniformGrid Columns="2">
                                                <Button Content="📶 Sort Lines" Command="{Binding ActionCommand}" CommandParameter="SortLines" Style="{StaticResource ToolButtonStyle}"/>
                                                <Button Content="✂️ Deduplicate" Command="{Binding ActionCommand}" CommandParameter="Deduplicate" Style="{StaticResource ToolButtonStyle}"/>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Expander>

                                    <!-- Clean & Filter -->
                                    <Expander Header="Clean &amp; Filter" controls:SectionState.Key="Lines_CleanFilter" Style="{StaticResource SectionExpanderStyle}">
                                        <StackPanel>
                                            <Button Content="🧹 Trim Spaces &amp; Remove Empty" Command="{Binding ActionCommand}" CommandParameter="TrimLines" Style="{StaticResource ToolButtonStyle}"/>
                                            <Grid Margin="0,3,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Text="{Binding FilterQuery, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CatalystTextBoxStyle}" Tag="Filter line text..."/>
                                                <Button Grid.Column="1" Content="🔍 Filter" Command="{Binding ActionCommand}" CommandParameter="FilterLines" Style="{StaticResource ToolButtonStyle}" Margin="3,0,0,0"/>
                                            </Grid>
                                        </StackPanel>
                                    </Expander>

                                    <!-- Number Lines -->
                                    <Expander Header="Number Lines" controls:SectionState.Key="Lines_NumberLines" Style="{StaticResource SectionExpanderStyle}">
                                        <Grid Margin="0,0,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Pattern: " VerticalAlignment="Center" Foreground="#AAAAAA" Margin="0,0,5,0" FontSize="11"/>
                                            <TextBox Grid.Column="1" Text="{Binding NumberFormat, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CatalystTextBoxStyle}"/>
                                            <Button Grid.Column="2" Content="🔢 Apply" Command="{Binding ActionCommand}" CommandParameter="NumberLines" Style="{StaticResource ToolButtonStyle}" Margin="3,0,0,0"/>
                                        </Grid>
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- TAB 3: TABULAR & DATA -->
                        <TabItem Header="📊 Tabular" Tag="{Binding IsTabularTabHighlighted}" Style="{StaticResource SidebarTabItemStyle}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
                                <StackPanel>
                                    <!-- Table Headers & Columns Selection -->
                                    <Expander Header="Headers &amp; Columns Selection" controls:SectionState.Key="Tabular_HeadersColumns" Style="{StaticResource SectionExpanderStyle}">
                                        <StackPanel>
                                            <!-- Table Headers Configuration -->
                                            <CheckBox Content="First row contains headers"
                                                      IsChecked="{Binding HasHeaders, Mode=TwoWay}"
                                                      Foreground="#D4D4D4"
                                                      FontSize="11"
                                                      Margin="0,0,0,6"
                                                      ToolTip="When checked, the first row of tabular data is used for column headers. When unchecked, all rows are treated as data."/>

                                            <!-- Column Selection -->
                                            <Grid Margin="0,0,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Columns Selection" Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center" Margin="0"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button Content="All" Command="{Binding SelectAllColumnsCommand}" Padding="4,1" FontSize="10" Style="{StaticResource CatalystButtonStyle}" Margin="0,0,2,0"/>
                                                    <Button Content="None" Command="{Binding DeselectAllColumnsCommand}" Padding="4,1" FontSize="10" Style="{StaticResource CatalystButtonStyle}" Margin="0,0,2,0"/>
                                                    <Button Content="Inv" Command="{Binding InvertColumnsCommand}" Padding="4,1" FontSize="10" Style="{StaticResource CatalystButtonStyle}"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Checkable Columns List -->
                                            <Border Background="#1E1E1E" BorderBrush="#3F3F3F" BorderThickness="1" CornerRadius="3" MaxHeight="100" Margin="0,0,0,6">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding ColumnItems}" Margin="3">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                          Content="{Binding DisplayText}"
                                                                          Foreground="#D4D4D4"
                                                                          FontSize="11"
                                                                          Margin="2,1"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Border>

                                            <!-- Single Column Selection Helper -->
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Target: " VerticalAlignment="Center" Foreground="#AAAAAA" Margin="0,0,5,0" FontSize="11"/>
                                                <ComboBox Grid.Column="1" ItemsSource="{Binding DetectedColumns}" SelectedItem="{Binding SelectedColumn, Mode=TwoWay}" Style="{StaticResource CatalystComboBoxStyle}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Expander>

                                    <!-- Break Apart & Extract Selected -->
                                    <Expander Header="Break Apart &amp; Extract" controls:SectionState.Key="Tabular_BreakApartExtract" Style="{StaticResource SectionExpanderStyle}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Delimiter: " VerticalAlignment="Center" Foreground="#AAAAAA" Margin="0,0,5,0" FontSize="11"/>
                                                <TextBox Grid.Column="1" Text="{Binding TableExtractDelimiter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CatalystTextBoxStyle}"/>
                                            </Grid>
                                            <UniformGrid Columns="2">
                                                <Button Content="📋 Delimited Lines" Command="{Binding ActionCommand}" CommandParameter="ExtractSelectedToLines" Style="{StaticResource PrimaryToolButtonStyle}"/>
                                                <Button Content="🔍 SQL IN (...)" Command="{Binding ActionCommand}" CommandParameter="ExtractSelectedToSqlIn" Style="{StaticResource PrimaryToolButtonStyle}"/>
                                                <Button Content="💻 C# String Array" Command="{Binding ActionCommand}" CommandParameter="ExtractSelectedToCodeArray" Style="{StaticResource ToolButtonStyle}"/>
                                                <Button Content="📊 CSV (Comma)" Command="{Binding ActionCommand}" CommandParameter="ExtractSelectedToCsv" Style="{StaticResource ToolButtonStyle}"/>
                                                <Button Content="📊 TSV (Tab)" Command="{Binding ActionCommand}" CommandParameter="ExtractSelectedToTsv" Style="{StaticResource ToolButtonStyle}"/>
                                                <Button Content="📝 Markdown Table" Command="{Binding ActionCommand}" CommandParameter="ExtractSelectedToMarkdown" Style="{StaticResource ToolButtonStyle}"/>
                                            </UniformGrid>
                                            <Button Content="📦 Extract Selected to JSON" Command="{Binding ActionCommand}" CommandParameter="ExtractSelectedToJson" Style="{StaticResource ToolButtonStyle}"/>
                                        </StackPanel>
                                    </Expander>

                                    <!-- Column Transforms -->
                                    <Expander Header="Transform Selected Columns" controls:SectionState.Key="Tabular_TransformSelectedColumns" Style="{StaticResource SectionExpanderStyle}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Content="🔠 UPPER" Command="{Binding ActionCommand}" CommandParameter="TransformSelectedUpper" Style="{StaticResource ToolButtonStyle}"/>
                                                <Button Grid.Column="1" Content="🔡 lower" Command="{Binding ActionCommand}" CommandParameter="TransformSelectedLower" Style="{StaticResource ToolButtonStyle}"/>
                                                <Button Grid.Column="2" Content="🧹 Trim" Command="{Binding ActionCommand}" CommandParameter="TransformSelectedTrim" Style="{StaticResource ToolButtonStyle}"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="35"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="35"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Pre: " VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="11"/>
                                                <TextBox Grid.Column="1" Text="{Binding TableColumnPrefix, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CatalystTextBoxStyle}" Margin="0,0,3,0"/>
                                                <TextBlock Grid.Column="2" Text="Suf: " VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="11"/>
                                                <TextBox Grid.Column="3" Text="{Binding TableColumnSuffix, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CatalystTextBoxStyle}"/>
                                            </Grid>
                                            <Button Content="➕ Apply Prefix / Suffix to Columns" Command="{Binding ActionCommand}" CommandParameter="TransformSelectedPrefixSuffix" Style="{StaticResource ToolButtonStyle}"/>

                                            <!-- Find and Replace in Columns -->
                                            <Grid Margin="0,3,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Text="{Binding TableColumnFind, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CatalystTextBoxStyle}" Tag="Find..." Margin="0,0,3,0"/>
                                                <TextBox Grid.Column="1" Text="{Binding TableColumnReplaceWith, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CatalystTextBoxStyle}" Tag="Replace..."/>
                                            </Grid>
                                            <Button Content="🔄 Find &amp; Replace in Columns" Command="{Binding ActionCommand}" CommandParameter="TransformSelectedReplace" Style="{StaticResource ToolButtonStyle}"/>
                                        </StackPanel>
                                    </Expander>

                                    <!-- Table Restructure & Filter -->
                                    <Expander Header="Table Structure &amp; Filter" controls:SectionState.Key="Tabular_TableStructureFilter" Style="{StaticResource SectionExpanderStyle}">
                                        <StackPanel>
                                            <UniformGrid Columns="2">
                                                <Button Content="📌 Keep Columns" Command="{Binding ActionCommand}" CommandParameter="KeepOnlySelectedColumns" Style="{StaticResource ToolButtonStyle}"/>
                                                <Button Content="🗑️ Drop Columns" Command="{Binding ActionCommand}" CommandParameter="DropSelectedColumns" Style="{StaticResource ToolButtonStyle}"/>
                                            </UniformGrid>

                                            <Grid Margin="0,3,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Text="{Binding TableFilterQuery, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CatalystTextBoxStyle}" Tag="Filter rows by col..."/>
                                                <Button Grid.Column="1" Content="🔍 Filter" Command="{Binding ActionCommand}" CommandParameter="FilterTableByColumn" Style="{StaticResource ToolButtonStyle}" Margin="3,0,0,0"/>
                                            </Grid>
                                            <UniformGrid Columns="2">
                                                <Button Content="📶 Sort by Col" Command="{Binding ActionCommand}" CommandParameter="SortTableByColumn" Style="{StaticResource ToolButtonStyle}"/>
                                                <Button Content="🔄 Transpose" Command="{Binding ActionCommand}" CommandParameter="TransposeTable" Style="{StaticResource ToolButtonStyle}"/>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Expander>

                                    <!-- Key-Value Generator -->
                                    <Expander Header="Key-Value Generator" controls:SectionState.Key="Tabular_KeyValueGenerator" Style="{StaticResource SectionExpanderStyle}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="35"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Key: " VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="11"/>
                                                <ComboBox Grid.Column="1" ItemsSource="{Binding DetectedColumns}" SelectedItem="{Binding SelectedKeyColumn, Mode=TwoWay}" Style="{StaticResource CatalystComboBoxStyle}"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="35"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Val: " VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="11"/>
                                                <ComboBox Grid.Column="1" ItemsSource="{Binding DetectedColumns}" SelectedItem="{Binding SelectedValueColumn, Mode=TwoWay}" Style="{StaticResource CatalystComboBoxStyle}"/>
                                            </Grid>
                                            <UniformGrid Columns="2">
                                                <Button Content="📦 JSON Object" Command="{Binding ActionCommand}" CommandParameter="TableToKeyValueJson" Style="{StaticResource ToolButtonStyle}"/>
                                                <Button Content="🔗 URL Query" Command="{Binding ActionCommand}" CommandParameter="TableToKeyValueQuery" Style="{StaticResource ToolButtonStyle}"/>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Expander>

                                    <!-- Whole Table Conversions -->
                                    <Expander Header="Full Table Conversions" controls:SectionState.Key="Tabular_FullTableConversions" Style="{StaticResource SectionExpanderStyle}">
                                        <UniformGrid Columns="2">
                                            <Button Content="📝 Markdown Table" Command="{Binding ActionCommand}" CommandParameter="ToMarkdownTable" Style="{StaticResource ToolButtonStyle}"/>
                                            <Button Content="📊 CSV (Comma)" Command="{Binding ActionCommand}" CommandParameter="ToCsv" Style="{StaticResource ToolButtonStyle}"/>
                                            <Button Content="📊 TSV (Tab)" Command="{Binding ActionCommand}" CommandParameter="ToTsv" Style="{StaticResource ToolButtonStyle}"/>
                                            <Button Content="🌐 HTML Table" Command="{Binding ActionCommand}" CommandParameter="ToHtmlTable" Style="{StaticResource ToolButtonStyle}"/>
                                            <Button Content="📦 JSON (Objects)" Command="{Binding ActionCommand}" CommandParameter="ToJsonObjects" Style="{StaticResource ToolButtonStyle}"/>
                                            <Button Content="📦 JSON (Arrays)" Command="{Binding ActionCommand}" CommandParameter="ToJsonArrays" Style="{StaticResource ToolButtonStyle}"/>
                                        </UniformGrid>
                                    </Expander>

                                    <!-- SQL INSERT -->
                                    <Expander Header="SQL INSERT Statements" controls:SectionState.Key="Tabular_SqlInsertStatements" Style="{StaticResource SectionExpanderStyle}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Table: " VerticalAlignment="Center" Foreground="#AAAAAA" Margin="0,0,5,0" FontSize="11"/>
                                                <TextBox Grid.Column="1" Text="{Binding SqlTableName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CatalystTextBoxStyle}"/>
                                            </Grid>
                                            <Button Content="💾 Generate SQL INSERTs" Command="{Binding ActionCommand}" CommandParameter="ToSqlInserts" Style="{StaticResource PrimaryToolButtonStyle}"/>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- TAB 4: CODE & FORMATS -->
                        <TabItem Header="💻 Code" Tag="{Binding IsCodeTabHighlighted}" Style="{StaticResource SidebarTabItemStyle}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
                                <StackPanel>
                                    <Expander Header="SQL Queries" controls:SectionState.Key="Code_SqlQueries" Style="{StaticResource SectionExpanderStyle}">
                                        <UniformGrid Columns="2">
                                            <Button Content="🔍 SQL IN (...)" Command="{Binding ActionCommand}" CommandParameter="SqlIn" Style="{StaticResource PrimaryToolButtonStyle}"/>
                                            <Button Content="📜 SQL Multi-Line" Command="{Binding ActionCommand}" CommandParameter="SqlInMultiLine" Style="{StaticResource ToolButtonStyle}"/>
                                        </UniformGrid>
                                    </Expander>

                                    <Expander Header="Code Array Literals" controls:SectionState.Key="Code_CodeArrayLiterals" Style="{StaticResource SectionExpanderStyle}">
                                        <StackPanel>
                                            <UniformGrid Columns="2">
                                                <Button Content="💻 C# Array" Command="{Binding ActionCommand}" CommandParameter="ToCSharpArray" Style="{StaticResource ToolButtonStyle}"/>
                                                <Button Content="💻 C# List" Command="{Binding ActionCommand}" CommandParameter="ToCSharpList" Style="{StaticResource ToolButtonStyle}"/>
                                                <Button Content="📜 TypeScript" Command="{Binding ActionCommand}" CommandParameter="ToTypeScriptArray" Style="{StaticResource ToolButtonStyle}"/>
                                                <Button Content="🐍 Python List" Command="{Binding ActionCommand}" CommandParameter="ToPythonList" Style="{StaticResource ToolButtonStyle}"/>
                                            </UniformGrid>
                                            <Button Content="📦 JSON Array: [ ... ]" Command="{Binding ActionCommand}" CommandParameter="ToJsonArray" Style="{StaticResource ToolButtonStyle}"/>
                                        </StackPanel>
                                    </Expander>

                                    <Expander Header="Web &amp; Parameters" controls:SectionState.Key="Code_WebParameters" Style="{StaticResource SectionExpanderStyle}">
                                        <StackPanel>
                                            <UniformGrid Columns="2">
                                                <Button Content="🌐 Query → KV" Command="{Binding ActionCommand}" CommandParameter="QueryStringToKv" Style="{StaticResource ToolButtonStyle}"/>
                                                <Button Content="🔗 KV → Query" Command="{Binding ActionCommand}" CommandParameter="KvToQueryString" Style="{StaticResource ToolButtonStyle}"/>
                                            </UniformGrid>
                                            <Button Content="📦 Key-Values → JSON Object" Command="{Binding ActionCommand}" CommandParameter="KvToJson" Style="{StaticResource ToolButtonStyle}"/>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- TAB 5: CASE & ENCODING -->
                        <TabItem Header="🔤 Case / Enc" Tag="{Binding IsCaseEncTabHighlighted}" Style="{StaticResource SidebarTabItemStyle}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
                                <StackPanel>
                                    <Expander Header="Case Conversions" controls:SectionState.Key="CaseEnc_CaseConversions" Style="{StaticResource SectionExpanderStyle}">
                                        <UniformGrid Columns="2">
                                            <Button Content="🐪 camelCase" Command="{Binding ActionCommand}" CommandParameter="CamelCase" Style="{StaticResource ToolButtonStyle}"/>
                                            <Button Content="📐 PascalCase" Command="{Binding ActionCommand}" CommandParameter="PascalCase" Style="{StaticResource ToolButtonStyle}"/>
                                            <Button Content="🐍 snake_case" Command="{Binding ActionCommand}" CommandParameter="SnakeCase" Style="{StaticResource ToolButtonStyle}"/>
                                            <Button Content="🍢 kebab-case" Command="{Binding ActionCommand}" CommandParameter="KebabCase" Style="{StaticResource ToolButtonStyle}"/>
                                            <Button Content="🔠 CONSTANT_CASE" Command="{Binding ActionCommand}" CommandParameter="ConstantCase" Style="{StaticResource ToolButtonStyle}"/>
                                            <Button Content="📰 Title Case" Command="{Binding ActionCommand}" CommandParameter="TitleCase" Style="{StaticResource ToolButtonStyle}"/>
                                            <Button Content="🔠 UPPERCASE" Command="{Binding ActionCommand}" CommandParameter="UpperCase" Style="{StaticResource ToolButtonStyle}"/>
                                            <Button Content="🔡 lowercase" Command="{Binding ActionCommand}" CommandParameter="LowerCase" Style="{StaticResource ToolButtonStyle}"/>
                                        </UniformGrid>
                                    </Expander>

                                    <Expander Header="Encodings &amp; Escapes" controls:SectionState.Key="CaseEnc_EncodingsEscapes" Style="{StaticResource SectionExpanderStyle}">
                                        <UniformGrid Columns="2">
                                            <Button Content="🌐 URL Encode" Command="{Binding ActionCommand}" CommandParameter="UrlEncode" Style="{StaticResource ToolButtonStyle}"/>
                                            <Button Content="🔓 URL Decode" Command="{Binding ActionCommand}" CommandParameter="UrlDecode" Style="{StaticResource ToolButtonStyle}"/>
                                            <Button Content="🔐 Base64 Encode" Command="{Binding ActionCommand}" CommandParameter="Base64Encode" Style="{StaticResource ToolButtonStyle}"/>
                                            <Button Content="🔓 Base64 Decode" Command="{Binding ActionCommand}" CommandParameter="Base64Decode" Style="{StaticResource ToolButtonStyle}"/>
                                            <Button Content="🏷️ HTML Encode" Command="{Binding ActionCommand}" CommandParameter="HtmlEncode" Style="{StaticResource ToolButtonStyle}"/>
                                            <Button Content="🔓 HTML Decode" Command="{Binding ActionCommand}" CommandParameter="HtmlDecode" Style="{StaticResource ToolButtonStyle}"/>
                                            <Button Content="💻 C# Escape" Command="{Binding ActionCommand}" CommandParameter="EscapeCSharp" Style="{StaticResource ToolButtonStyle}"/>
                                            <Button Content="💻 C# Unescape" Command="{Binding ActionCommand}" CommandParameter="UnescapeCSharp" Style="{StaticResource ToolButtonStyle}"/>
                                            <Button Content="✨ JSON Beautify" Command="{Binding ActionCommand}" CommandParameter="FormatJson" Style="{StaticResource ToolButtonStyle}"/>
                                            <Button Content="✨ XML Beautify" Command="{Binding ActionCommand}" CommandParameter="FormatXml" Style="{StaticResource ToolButtonStyle}"/>
                                            <Button Content="✨ Auto Beautify" Command="{Binding ActionCommand}" CommandParameter="Beautify" Style="{StaticResource ToolButtonStyle}"/>
                                            <Button Content="🔑 JWT Decode" Command="{Binding ActionCommand}" CommandParameter="JwtDecode" Style="{StaticResource ToolButtonStyle}"/>
                                        </UniformGrid>
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Background="#007ACC" Padding="10,3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="TextForge v1.0 | Ready" Foreground="#E0E0E0" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
